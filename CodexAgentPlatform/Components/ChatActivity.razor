@inject IJSRuntime JS

<button type="button" class="activity-launch" aria-haspopup="dialog" @onclick="OpenAsync">
    <span class="activity-symbol"><Icon Name="memory" /></span>
    <span><strong>Work summary</strong><small>@Summary</small></span>
    <Icon Name="chevron" />
</button>

<dialog class="chat-sheet activity-sheet" @ref="sheet" aria-labelledby="activity-title">
    <header class="sheet-head"><h2 id="activity-title">Work summary</h2>
        <form method="dialog"><button class="icon-button" aria-label="Close summary" autofocus><Icon Name="close" /></button></form>
    </header>
    @if (loaded)
    {
        <div class="sheet-filter" role="group" aria-label="Record type">
            @foreach (var group in Groups)
            {
                <button type="button" aria-pressed="@(group == category ? "true" : "false")" @onclick="() => Select(group)">@group</button>
            }
        </div>
        <div class="sheet-list">
            @if (category == ApprovalsLabel)
            {
                @foreach (var row in Approvals.Take(limit))
                {
                    <details class="activity-item" @key="row.Id"><summary><Icon Name="approve" /><span><strong>@ApprovalLabel(row.Status)</strong>
                        <small>@When(row.CreatedAtUtc) @(row.DecidedBy == Operations.AutomaticDecision ? "· Automatic" : "")</small></span></summary>
                        <div class="activity-detail"><p>@ApprovalDisplay.Scope(row.Scope)</p>
                            @if (Operations.SshCommandScript(row) is { } script) { <pre dir="ltr">@script</pre> }
                            @if (!string.IsNullOrWhiteSpace(row.Result)) { <pre>@row.Result</pre> }
                            <a href="/approvals">Open approvals</a>
                        </div>
                    </details>
                }
            }
            else
            {
                @foreach (var entry in FilteredEvents.Take(limit))
                {
                    <details class="activity-item" @key="entry.Id"><summary><Icon Name="@(IsFile(entry) ? "file" : "timeline")" />
                        <span><strong>@EventTitle(entry)</strong><small>@When(entry.EventOccurredAtUtc)</small></span></summary>
                        <div class="activity-detail">
                            @if (entry.Kind == "Diff" && entry.Detail.Length > 0)
                            {
                                var lines = entry.Detail.Split('\n');
                                <div class="diff-preview">
                                    @foreach (var line in lines.Take(6))
                                    {
                                        <code class="@(line.StartsWith('+') ? "added" : line.StartsWith('-') ? "removed" : null)">@line</code>
                                    }
                                </div>
                                @if (lines.Length > 6)
                                {
                                    <details class="code-fold"><summary>Show remaining lines</summary><pre>@string.Join('\n', lines.Skip(6))</pre></details>
                                }
                            }
                            else if (entry.Detail.Length > 0) { <pre>@entry.Detail</pre> }
                            @if (entry.Artifact is { } href && href.EndsWith(".txt")) { <a href="/artifacts/@href">Download full output</a> }
                            @if (entry.Detail.Length == 0 && entry.Artifact is null) { <p class="muted">No additional output.</p> }
                        </div>
                    </details>
                }
            }
            @if (limit < (category == ApprovalsLabel ? Approvals.Count : FilteredEvents.Count()))
            { <button type="button" class="button more-events" @onclick="() => limit += 6">Show more</button> }
        </div>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public List<Activity> Events { get; set; } = [];
    [Parameter, EditorRequired] public List<Approval> Approvals { get; set; } = [];
    [Parameter, EditorRequired] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Utc;
    private const string Files = "Files", Actions = "Actions", ApprovalsLabel = "Approvals";
    private string Summary => Approvals.Count == 0 ? $"{Events.Count} events" : $"{Events.Count} events · {Approvals.Count} approval records";
    private string category = Files;
    private ElementReference sheet;
    private int limit = 6;
    private bool loaded;
    private IEnumerable<Activity> FilteredEvents => Events.Where(e => IsFile(e) == (category == Files));
    private IEnumerable<string> Groups
    {
        get
        {
            if (Events.Any(IsFile)) yield return Files;
            if (Events.Any(e => !IsFile(e))) yield return Actions;
            if (Approvals.Count > 0) yield return ApprovalsLabel;
        }
    }

    private async Task OpenAsync()
    {
        loaded = true;
        Select(Groups.First());
        await JS.InvokeVoidAsync("platformChat.openDialog", sheet);
    }
    private void Select(string group) { category = group; limit = 6; }
    private string When(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), Zone).ToString("dd.MM · HH:mm");
    private static bool IsFile(Activity e) => e.Kind is "fileChange" or "Diff" or "CodeModified";
    private static string EventTitle(Activity entry)
    {
        if (entry.Kind != "fileChange") return Label(entry.Kind);
        try
        {
            using var json = System.Text.Json.JsonDocument.Parse(entry.Detail);
            if (json.RootElement.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                var files = json.RootElement.EnumerateArray().Select(x => x.String("path"))
                    .Where(p => !string.IsNullOrWhiteSpace(p)).Distinct().ToArray();
                if (files.Length > 0)
                {
                    var file = files[0]!.Replace('\\', '/').Split('/').Last();
                    return files.Length == 1 ? file : $"{file} · +{files.Length - 1} files";
                }
            }
        }
        catch (System.Text.Json.JsonException) { /* Stored events can contain a clipped preview. */ }
        return Label(entry.Kind);
    }
    private static string Label(string kind) => kind switch
    {
        "Diff" => "Diff", "fileChange" or "CodeModified" => "File change",
        "commandExecution" => "Command output", "ToolCalled" => "Tool call", "webSearch" => "Web search",
        "TurnCompleted" => "Response completed", "TurnInterrupted" => "Work interrupted", "TurnFailed" => "Operation failed",
        "AutoApproved" => "Automatically approved", "AutoApprovalEnabled" => "Auto-approval enabled",
        "AutoApprovalDisabled" => "Auto-approval disabled", "ApprovalRequested" => "Approval requested",
        "TestExecuted" => "Test executed", "ProjectSelected" => "Project selected", "ProjectCleared" => "Project selection cleared", "WorkProgress" => "Work updated",
        "WorkspaceUnavailable" => "Workspace unavailable", "AgentHandoff" => "Agent handoff",
        "AgentHandoffWaiting" => "Handoff awaiting access", "AgentHandoffUnavailable" => "Handoff unavailable",
        "PermissionGrantRequested" => "Permission requested", "PermissionGranted" => "Permission granted",
        "PermissionGrantDeclined" => "Permission request declined", "ProjectCreated" => "Project created", _ => kind
    };
    private static string ApprovalLabel(string status) => status switch
    {
        "Pending" => "Awaiting approval", "Approved" => "Approved", "Declined" => "Declined", "Expired" => "Expired",
        "Executing" => "Executing", "Completed" => "Completed", "Failed" => "Failed", "Interrupted" => "Interrupted", _ => status
    };
}
