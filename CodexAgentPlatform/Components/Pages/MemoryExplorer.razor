@page "/memory"
@attribute [Authorize]
@inject MemoryStore Store
@inject IDbContextFactory<PlatformDb> Dbs

<PageTitle>Hafıza · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head">
        <h1>Hafıza</h1><button class="primary" @ref="addButton" disabled="@busy" @onclick="NewNote">＋ Not ekle</button>
    </header>
    <form class="filter" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <input placeholder="Başlık, özet veya etiket…" aria-label="Hafıza ara" @bind="query" maxlength="150" />
        <label class="check"><input type="checkbox" @bind="archived" /> Arşiv dahil</label>
        <button class="button" type="submit" disabled="@busy">Ara</button>
    </form>
    @if (!editing && error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (!editing && notice is not null) { <p class="notice" role="status">@notice</p> }
    <div class="split-panel">
        <div class="list">
            @foreach (var note in rows)
            {
                <button class="list-row" disabled="@busy" @onclick="() => OpenAsync(note)">
                    <span><strong>@note.Title</strong><small>@note.Summary</small><small>@note.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC · @note.Verification</small></span>
                    <small>@(note.Archived ? "Arşiv" : $"v{note.Version}")</small>
                </button>
            }
            @if (rows.Count == 0) { <p class="empty">Hafıza kaydı bulunamadı.</p> }
        </div>
        @if (editing)
        {
            <form class="card fields" aria-busy="@busy" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <h2 @ref="editorHeading" tabindex="-1">@(selected is null ? "Yeni not" : selected.Title)</h2>
                <label>Başlık <input @bind="title" maxlength="160" required /></label>
                <label>Özet <input @bind="summary" maxlength="600" /></label>
                <label>Etiketler <input @bind="tags" maxlength="300" /></label>
                <label>Doğrulama
                    <select @bind="verification"><option value="hypothesis">Hipotez</option><option value="inference">Çıkarım</option><option value="verified">Doğrulandı</option></select>
                </label>
                @if (selected is null)
                {
                    <label>Proje <select @bind="project"><option value="">Genel</option>
                        @foreach (var p in projects) { <option value="@p.Id">@p.Name</option> }
                    </select></label>
                }
                else
                {
                    <p class="muted">@ProjectName(selected.ProjectId) · @selected.CreatedAtUtc.ToString("dd.MM.yyyy") · v@selected.Version</p>
                }
                <label>Markdown <textarea class="mono" @bind="body" maxlength="32000" rows="11" required></textarea></label>
                @if (error is not null) { <p class="notice error" role="alert">@error</p> }
                @if (notice is not null) { <p class="notice" role="status">@notice</p> }
                <div class="actions">
                    <button class="primary" type="submit" disabled="@busy">Kaydet</button>
                    <button type="button" class="button" disabled="@busy" @onclick="CancelEdit">İptal</button>
                    @if (selected is { Archived: false }) { <button type="button" class="button" disabled="@busy" @onclick="ArchiveAsync">Arşivle</button> }
                </div>
                @if (selected is { Version: > 1 })
                {
                    <label>Önceki sürümü düzenleyiciye yükle
                        <select value="@selected.Version" disabled="@busy" @onchange="ReadVersionAsync">
                            @foreach (var v in Enumerable.Range(1, selected.Version).Reverse()) { <option value="@v">v@v</option> }
                        </select>
                    </label>
                }
                <details><summary>Önizleme</summary><MarkdownBody Text="@body" /></details>
            </form>
        }
    </div>
</section>

@code {
    private List<MemoryNote> rows = [];
    private List<Project> projects = [];
    private MemoryNote? selected;
    private string? query, error, notice, project;
    private string title = "", summary = "", tags = "", verification = "hypothesis", body = "";
    private bool archived, editing, busy, focusOnRender, focusAddOnRender;
    private ElementReference editorHeading, addButton;
    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        projects = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOnRender)
        {
            focusOnRender = false;
            await editorHeading.FocusAsync();
        }
        else if (focusAddOnRender)
        {
            focusAddOnRender = false;
            await addButton.FocusAsync();
        }
    }

    private async Task LoadAsync() => rows = await Store.SearchAsync(query, null, null, archived, default);
    private Task SearchAsync() => RunAsync(LoadAsync);
    private void NewNote()
    {
        if (busy) return;
        selected = null; error = notice = null; project = null; editing = true;
        title = summary = tags = body = ""; verification = "hypothesis";
        focusOnRender = true;
    }
    private void CancelEdit()
    {
        if (busy) return;
        editing = false;
        selected = null;
        error = notice = null;
        focusAddOnRender = true;
    }

    private Task OpenAsync(MemoryNote note) => RunAsync(async () =>
    {
        body = await Store.ReadAsync(note.Id, null, null, default);
        selected = note; editing = true;
        (title, summary, tags, verification, project) = (note.Title, note.Summary, note.Tags, note.Verification, note.ProjectId);
        focusOnRender = true;
    });
    private Task SaveAsync() => RunAsync(async () =>
    {
        var saved = await Store.SaveAsync(selected?.Id, new MemoryDraft(title, summary, tags, body, verification, selected?.SourceReferences),
            selected?.AgentId, string.IsNullOrEmpty(project) ? null : project, selected?.SourceTaskId, null, default,
            admin: true, expectedVersion: selected?.Version);
        selected = saved;
        await LoadAsync();
        notice = "Not kaydedildi.";
    });
    private Task ArchiveAsync() => RunAsync(async () =>
    {
        if (selected is not { } note) return;
        await Store.ArchiveAsync(note.Id, null, null, null, true, default);
        editing = false; selected = null;
        await LoadAsync();
        notice = "Not arşive alındı.";
        focusAddOnRender = true;
    });
    private Task ReadVersionAsync(ChangeEventArgs e) => RunAsync(async () =>
    {
        if (selected is { } note && int.TryParse(e.Value?.ToString(), out var number))
            body = await Store.ReadAsync(note.Id, number, null, default);
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        error = notice = null;
        try { await action(); }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or DbUpdateException)
        { error = ex is InvalidOperationException ? ex.Message : "Hafıza kaydı okunamadı veya yazılamadı."; }
        finally { busy = false; }
    }
    private string ProjectName(string? id) => projects.Find(p => p.Id == id)?.Name ?? "Genel";
}
