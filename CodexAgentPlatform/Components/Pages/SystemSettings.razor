@page "/system"
@attribute [Authorize]
@inject IDbContextFactory<PlatformDb> Dbs
@inject StorageStartup Storage
@inject Vault Vault

<PageTitle>Sistem · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head"><h1>Sistem</h1></header>
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }
    @if (prefs is not null)
    {
        <form class="card fields" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>Bağlam ve saat dilimi</h2>
            <label>Saat dilimi <input @bind="prefs.TimeZone" placeholder="Europe/Istanbul" maxlength="80" required /></label>
            <label>Ek bağlam sınırı (karakter) <input type="number" @bind="prefs.ContextCharacters" min="4000" max="24000" /></label>
            <div><button class="primary">Kaydet</button></div>
        </form>
    }
    <article class="card fields">
        <h2>Depolama</h2>
        <p>Credential Vault <strong>@(Vault.Configured ? "Yapılandırılmış" : "Anahtar dosyası bekleniyor")</strong></p>
        <div><button class="button" disabled="@backingUp" @onclick="BackupAsync">SQLite yedeği al</button></div>
    </article>
</section>

@code {
    private Preferences? prefs;
    private string? notice;
    private bool backingUp;
    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        prefs = await db.Preferences.AsNoTracking().SingleAsync();
    }
    private async Task SaveAsync()
    {
        if (prefs is null) return;
        var zone = prefs.TimeZone.Trim();
        if (!TimeZoneInfo.TryFindSystemTimeZoneById(zone, out _) || prefs.ContextCharacters is < 4000 or > 24000)
        { notice = "Geçerli bir saat dilimi ve 4.000–24.000 karakter arası sınır girin."; return; }
        await using var db = await Dbs.CreateDbContextAsync();
        await db.Preferences.ExecuteUpdateAsync(s => s.SetProperty(x => x.TimeZone, zone)
            .SetProperty(x => x.ContextCharacters, prefs.ContextCharacters));
        notice = "Sistem ayarları kaydedildi.";
    }
    private async Task BackupAsync()
    {
        backingUp = true;
        try { notice = $"Yedek kaydedildi · {await Storage.BackupAsync(default)}"; }
        catch (Exception ex) when (ex is IOException or Microsoft.Data.Sqlite.SqliteException) { notice = "Yedek kaydedilemedi."; }
        finally { backingUp = false; }
    }
}
