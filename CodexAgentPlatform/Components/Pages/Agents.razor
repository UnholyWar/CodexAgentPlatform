@page "/agents"
@attribute [Authorize]
@inject IDbContextFactory<PlatformDb> Dbs
@inject CodexAccounts Accounts
@inject PlatformPaths Paths

<PageTitle>Agents · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head">
        <h1>Agents</h1><button class="primary" @ref="addButton" disabled="@busy" @onclick="NewAgent"><Icon Name="plus" /> Add agent</button>
    </header>
    @if (edit is null && error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }
    <div class="split-panel">
        <div class="list">
            @foreach (var agent in agents)
            {
                <button class="list-row" disabled="@busy" @onclick="() => EditAsync(agent.Id)">
                    <span class="avatar" aria-hidden="true">@agent.Name.FirstOrDefault()</span>
                    <span><strong>@agent.Name</strong><small>@agent.Title</small></span>
                    <small>@(agent.Archived ? "Archived" : stats.GetValueOrDefault(agent.Id).ToString("N0") + " token")</small>
                </button>
            }
        </div>
        @if (edit is not null)
        {
            <form class="card fields" aria-busy="@busy" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <button type="button" class="editor-back" disabled="@busy" @onclick="CancelEdit"><Icon Name="chevron" /> Agent list</button>
                <h2 @ref="editorHeading" tabindex="-1">@(isNew ? "New agent" : edit.Name)</h2>
                <label>Name <input @bind="edit.Name" required minlength="2" maxlength="60" /></label>
                <label>Title <input @bind="edit.Title" required minlength="2" maxlength="120" /></label>
                <label>Role instructions <textarea @bind="edit.Instructions" maxlength="8000" rows="5"></textarea></label>
                <div class="fields side-by-side"><ModelFields Models="models" @bind-Model="edit.Model" @bind-Effort="edit.Effort" /></div>
                <div><button type="button" class="button" disabled="@busy" @onclick="LoadModelsAsync">Load models</button></div>
                @if (modelError is not null) { <p class="notice error" role="alert">@modelError</p> }
                <label>Voice
                    <select @bind="edit.Voice" disabled="@loadingVoices">
                        <option value="">Default voice</option>
                        @if (edit.Voice is { Length: > 0 } savedVoice && !voices.Contains(savedVoice))
                        {
                            <option value="@savedVoice">@VoiceLabel(savedVoice)</option>
                        }
                        @foreach (var voice in voices)
                        {
                            <option value="@voice">@VoiceLabel(voice)</option>
                        }
                    </select>
                </label>
                @if (loadingVoices) { <small role="status">Loading voice options…</small> }
                @if (voiceError is not null)
                {
                    <div class="actions"><small role="status">@voiceError</small><button type="button" class="button" @onclick="LoadVoicesAsync">Retry</button></div>
                }
                <fieldset>
                    <legend>Tool permissions</legend>
                    @foreach (var tool in ToolAccess.Permissions)
                    {
                        <label class="check"><input type="checkbox" checked="@allowedTools.Contains(tool.Key)"
                            @onchange="e => Toggle(allowedTools, tool.Key, e)" /> @tool.Value</label>
                    }
                </fieldset>
                @if (projects.Count > 0)
                {
                    <fieldset>
                        <legend>Project permissions</legend>
                        @foreach (var project in projects)
                        {
                            <label class="check"><input type="checkbox" checked="@allowedProjects.Contains(project.Id)"
                                @onchange="e => Toggle(allowedProjects, project.Id, e)" /> @project.Name</label>
                        }
                    </fieldset>
                }
                <label class="check"><input type="checkbox" @bind="edit.Archived" /> Archive</label>
                @if (error is not null) { <p class="notice error" role="alert">@error</p> }
                <div class="actions">
                    <button class="primary" type="submit" disabled="@busy">Save</button>
                    <button class="button" type="button" disabled="@busy" @onclick="CancelEdit">Cancel</button>
                </div>
            </form>
        }
    </div>
</section>

@code {
    private List<Agent> agents = [];
    private List<Project> projects = [];
    private Dictionary<string, long> stats = [];
    private List<CodexModel> models = [];
    private string[] voices = [];
    private Agent? edit;
    private bool isNew, busy, loadingVoices, focusOnRender, focusAddOnRender;
    private string? error, modelError, voiceError, notice;
    private ElementReference editorHeading, addButton;
    private HashSet<string> allowedTools = [], allowedProjects = [];

    protected override Task OnInitializedAsync() => ReloadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOnRender)
        {
            focusOnRender = false;
            await editorHeading.FocusAsync();
        }
        else if (focusAddOnRender)
        {
            focusAddOnRender = false;
            await addButton.FocusAsync();
        }
    }

    private async Task ReloadAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        agents = await db.Agents.AsNoTracking().OrderBy(x => x.Archived).ThenBy(x => x.Name).ToListAsync();
        projects = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        stats = await db.Usage.GroupBy(x => x.AgentId).Select(g => new { Id = g.Key, Total = g.Sum(x => x.Total) })
            .ToDictionaryAsync(x => x.Id, x => x.Total);
    }
    private async Task NewAgent()
    {
        if (busy) return;
        edit = new();
        isNew = true;
        error = modelError = notice = null;
        allowedTools = ["memory"];
        allowedProjects = [];
        focusOnRender = true;
        if (voices.Length == 0) await LoadVoicesAsync();
    }

    private void CancelEdit()
    {
        if (busy) return;
        edit = null;
        error = modelError = null;
        focusAddOnRender = true;
    }

    private async Task EditAsync(string id)
    {
        if (busy) return;
        busy = true;
        error = modelError = notice = null;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var agent = await db.Agents.AsNoTracking().SingleOrDefaultAsync(x => x.Id == id);
            if (agent is null)
            {
                error = "This agent no longer exists.";
                await ReloadAsync();
                return;
            }
            projects = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
            edit = agent;
            isNew = false;
            allowedTools = ToolAccess.Split(agent.AllowedTools).ToHashSet();
            allowedProjects = ToolAccess.Split(agent.AllowedProjects).ToHashSet();
            focusOnRender = true;
        }
        finally { busy = false; }
        if (edit is not null && voices.Length == 0) await LoadVoicesAsync();
    }
    private async Task LoadVoicesAsync()
    {
        if (loadingVoices) return;
        loadingVoices = true;
        voiceError = null;
        try
        {
            voices = await Accounts.VoicesAsync(default);
            if (voices.Length == 0) voiceError = "Codex returned no voice options.";
        }
        catch (Exception ex) when (ex is CodexRpcException or IOException or InvalidOperationException or TimeoutException or OperationCanceledException)
        {
            voiceError = "Could not load voice options from Codex.";
        }
        finally { loadingVoices = false; }
    }

    private static string VoiceLabel(string voice) => char.ToUpperInvariant(voice[0]) + voice[1..];
    private async Task LoadModelsAsync()
    {
        if (busy) return;
        busy = true;
        modelError = null;
        try { models = await Accounts.ModelsAsync(default); }
        catch (Exception ex) { modelError = ex is CodexRpcException ? ex.Message : "Could not retrieve the Codex model list."; }
        finally { busy = false; }
    }
    private async Task SaveAsync()
    {
        if (busy || edit is not { } draft) return;
        busy = true;
        error = null;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();
            var row = isNew ? new Agent { Id = draft.Id } : await db.Agents.SingleAsync(x => x.Id == draft.Id);
            row.Name = draft.Name.Trim();
            row.Title = draft.Title.Trim();
            if (row.Name.Length is < 2 or > 60)
                throw new ArgumentException("Enter an agent name between 2 and 60 characters.");
            if (row.Title.Length is < 2 or > 120)
                throw new ArgumentException("Enter an agent title between 2 and 120 characters.");
            if (draft.Instructions.Length > 8000)
                throw new ArgumentException("Keep the role instructions to 8,000 characters or fewer.");
            row.Instructions = draft.Instructions;
            row.Model = draft.Model;
            row.Effort = draft.Effort;
            var voice = string.IsNullOrEmpty(draft.Voice) ? null : draft.Voice;
            if (voice is not null && voice != row.Voice && !voices.Contains(voice))
                throw new ArgumentException("Select a voice from the Codex voice list.");
            row.Voice = voice;
            row.Archived = draft.Archived;
            var addedProjects = allowedProjects.Except(ToolAccess.Split(draft.AllowedProjects)).ToArray();
            if (addedProjects.Length > 0 && await db.Projects.CountAsync(p => addedProjects.Contains(p.Id)) != addedProjects.Length)
                throw new ArgumentException("A selected project was deleted. Reopen this agent to refresh its project permissions.");
            row.AllowedTools = ToolAccess.ApplySelectionChanges(row.AllowedTools, draft.AllowedTools, allowedTools);
            row.AllowedProjects = ToolAccess.ApplySelectionChanges(row.AllowedProjects, draft.AllowedProjects, allowedProjects);
            if (isNew) db.Agents.Add(row);
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            isNew = false;
            await WorkspaceMemory.WriteAgentAsync(Paths, row, default);
            await ReloadAsync();
            edit = null;
            focusAddOnRender = true;
            notice = "Agent saved.";
        }
        catch (DbUpdateException ex) when (ex.InnerException is Microsoft.Data.Sqlite.SqliteException { SqliteExtendedErrorCode: 2067 })
        { error = "This agent name is already in use."; }
        catch (Exception ex) when (ex is DbUpdateException or ArgumentException or IOException or InvalidOperationException)
        { error = ex is ArgumentException ? ex.Message : "Could not save the agent or its Markdown identity."; }
        finally { busy = false; }
    }
    private static void Toggle(HashSet<string> set, string id, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(id); else set.Remove(id);
    }
}
