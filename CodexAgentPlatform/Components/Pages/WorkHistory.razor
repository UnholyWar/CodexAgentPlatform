@page "/work"
@attribute [Authorize]
@inject IDbContextFactory<PlatformDb> Dbs

<PageTitle>Work history · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head"><h1>Work history</h1></header>
    <div class="list">
        @foreach (var work in rows)
        {
            <details class="work-row">
                <summary><strong>@work.Title</strong> <span class="status">@work.Status</span> <small>@work.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</small></summary>
                <div class="details-body">
                    <p>@work.Description</p>
                    @if (work.LastStep is not null) { <p><strong>Last step</strong> @work.LastStep</p> }
                    @if (work.NextStep is not null) { <p><strong>Next step</strong> @work.NextStep</p> }
                    @if (work.Branch is not null) { <p><strong>Branch</strong> <code>@work.Branch</code></p> }
                    @if (work.Commit is not null) { <p><strong>Commit</strong> <code>@work.Commit</code></p> }
                    <a href="/chat/@work.ConversationId">Open conversation</a>
                </div>
            </details>
        }
        @if (rows.Count == 0) { <p class="empty">No work items found.</p> }
    </div>
</section>

@code {
    private List<WorkItem> rows = [];
    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        rows = await db.Work.AsNoTracking().OrderByDescending(x => x.UpdatedAtUtc).Take(100).ToListAsync();
    }
}
