@page "/resources"
@attribute [Authorize]
@inject IDbContextFactory<PlatformDb> Dbs
@inject Vault Vault

<PageTitle>Kaynaklar · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head"><h1>Kaynaklar</h1><button @ref="addButton" class="primary" disabled="@busy" @onclick="NewResource">＋ Kaynak ekle</button></header>
    @if (notice is not null) { <p @ref="feedback" class="notice" role="status" tabindex="-1">@notice</p> }
    @if (selected is null && error is not null) { <p class="notice error" role="alert">@error</p> }
    <div class="split-panel">
        <div class="list">
            @foreach (var item in rows)
            {
                <button class="list-row" disabled="@busy" aria-pressed="@(selected?.Id == item.Id ? "true" : "false")" @onclick="() => EditAsync(item.Id)"><span class="avatar" aria-hidden="true">⊞</span>
                    <span><strong>@item.Name</strong><small>@item.Kind · @item.Address</small></span></button>
            }
            @if (rows.Count == 0) { <p class="empty">Henüz kaynak eklenmedi.</p> }
        </div>
        @if (selected is not null)
        {
            <form class="card fields" aria-labelledby="resource-editor" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <h2 id="resource-editor" @ref="editorHeading" tabindex="-1">@(savedName is null ? "Yeni kaynak" : "Kaynağı düzenle")</h2>
                <label>Kaynak adı <input @bind="selected.Name" maxlength="100" required disabled="@busy" /></label>
                <label>Tür <select @bind="selected.Kind" @bind:after="SourceTypeChanged" disabled="@busy">@foreach (var kind in Enum.GetValues<ResourceKind>()) { <option value="@kind">@kind</option> }</select></label>
                <label>Proje
                    <select @bind="selected.ProjectId" @bind:after="ClearInvalidSshSelection" required disabled="@busy">
                        <option value="">Proje seçin</option>
                        @foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }
                    </select>
                </label>
                <label>@(selected.Kind switch { ResourceKind.SshServer => "Hostname veya IP", ResourceKind.GitRepository => "HTTPS depo adresi", ResourceKind.DeploymentTarget => "Docker Swarm servis adı", _ => "Adres" })
                    <input @bind="selected.Address" maxlength="1024" required disabled="@busy" /></label>
                @if (selected.Kind == ResourceKind.GitRepository)
                {
                    <label class="check"><input type="checkbox" @bind="gitUsesToken" @bind:after="ClearCredential" disabled="@busy" /> Özel depo (HTTPS erişim belirteci kullan)</label>
                    @if (gitUsesToken)
                    {
                        <label>Git kullanıcı adı (isteğe bağlı) <input @bind="selected.Username" maxlength="120" disabled="@busy" /></label>
                        <label>Git erişim belirteci (PAT)
                            <input type="password" @bind="credential" maxlength="65536" autocomplete="new-password" required="@(Vault.Configured && selected.VaultId is null)" disabled="@(busy || !Vault.Configured)" />
                        </label>
                    }
                }
                @if (selected.Kind == ResourceKind.SshServer)
                {
                    <label>SSH kullanıcı adı <input @bind="selected.Username" maxlength="120" required disabled="@busy" /></label>
                    <label>SSH portu <input type="number" @bind="selected.Port" min="1" max="65535" required disabled="@busy" /></label>
                    <label>Sunucu anahtarının parmak izi <input @bind="selected.HostFingerprint" placeholder="SHA256:…" maxlength="64" required disabled="@busy" /></label>
                    <label>SSH özel anahtarı
                        <textarea @bind="credential" rows="4" spellcheck="false" autocomplete="off" maxlength="65536" required="@(Vault.Configured && selected.VaultId is null)" disabled="@(busy || !Vault.Configured)"></textarea>
                    </label>
                    <small class="muted">Parolasız özel anahtarın tamamını girin. Açık anahtar (.pub) uzak sunucuda bu kullanıcının authorized_keys dosyasına eklenir.</small>
                    <label>İsteğe bağlı SFTP metin dosyası <input @bind="selected.SftpFile" placeholder="/srv/reports/status.txt" maxlength="512" disabled="@busy" /></label>
                }
                @if (selected.Kind == ResourceKind.DeploymentTarget)
                {
                    var hosts = SshServers(selected).ToArray();
                    <label>SSH sunucusu
                        <select @bind="selected.SshServerId" required disabled="@busy" aria-describedby="source-ssh-help">
                            <option value="">Seçin</option>
                            @foreach (var host in hosts)
                            { <option value="@host.Id">@host.Name</option> }
                        </select>
                    </label>
                    <small id="source-ssh-help" class="muted">
                        @(string.IsNullOrEmpty(selected.ProjectId) ? "Önce proje seçin."
                            : hosts.Length == 0 ? "Bu projeye bir SSH kaynağı ekleyin." : "Seçili projenin SSH kaynakları gösteriliyor.")
                    </small>
                }
                @if (selected.Kind is not (ResourceKind.DeploymentTarget or ResourceKind.GitRepository or ResourceKind.SshServer) && Vault.Configured)
                {
                    <label>Yeni Vault değeri
                        <textarea @bind="credential" rows="3" autocomplete="off" maxlength="65536" disabled="@busy"></textarea>
                    </label>
                }
                @if (selected.Kind != ResourceKind.DeploymentTarget && (selected.Kind != ResourceKind.GitRepository || gitUsesToken))
                {
                    @if (!Vault.Configured)
                    {
                        <small class="muted">Gizli değer kaydetmek için sunucuda Platform__VaultKeyFile ayarını yapılandırın.</small>
                    }
                    else if (selected.VaultId is not null)
                    {
                        <small class="muted">Bağlantı bilgileri aynı kaldığında boş alan kayıtlı kimlik bilgisini korur.</small>
                    }
                }
                <label class="check"><input type="checkbox" @bind="selected.Production" disabled="@busy" /> Üretim kaynağı</label>
                @if (error is not null) { <p class="notice error" role="alert">@error</p> }
                @if (confirmDelete)
                {
                    <div class="notice error fields" role="group" aria-labelledby="resource-delete-title">
                        <strong id="resource-delete-title" @ref="confirmationHeading" tabindex="-1">“@savedName” kaynağını silmek istiyor musunuz?</strong>
                        <div class="actions">
                            <button class="button" type="button" disabled="@busy" @onclick="CancelDelete">Vazgeç</button>
                            <button class="button danger" type="button" disabled="@busy" @onclick="DeleteAsync">Kaynağı sil</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="actions">
                        <button class="primary" type="submit" disabled="@busy">Kaydet</button>
                        <button class="button" type="button" disabled="@busy" @onclick="CancelEditor">İptal</button>
                        @if (savedName is not null)
                        {
                            <button @ref="deleteButton" class="button danger" type="button" disabled="@busy" @onclick="ConfirmDelete">Sil</button>
                        }
                    </div>
                }
            </form>
        }
    </div>
</section>

@code {
    private List<Resource> rows = [];
    private List<Project> projects = [];
    private Resource? selected;
    private string? credential, error, notice, savedName;
    private bool busy, confirmDelete, focusOnRender, returnToDeleteButton, gitUsesToken;
    private ElementReference addButton, editorHeading, confirmationHeading, deleteButton, feedback;
    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusOnRender) return;
        focusOnRender = false;
        var target = returnToDeleteButton ? deleteButton
            : selected is not null ? (confirmDelete ? confirmationHeading : editorHeading)
            : (notice is not null ? feedback : addButton);
        returnToDeleteButton = false;
        try { await target.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task LoadAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        rows = await db.Resources.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        projects = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    private void NewResource()
    {
        if (busy) return;
        CancelEditor();
        selected = new();
    }

    private async Task EditAsync(string id)
    {
        if (busy) return;
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            selected = await db.Resources.AsNoTracking().SingleOrDefaultAsync(x => x.Id == id);
            savedName = selected?.Name;
            gitUsesToken = selected is { Kind: ResourceKind.GitRepository, VaultId: not null };
            credential = notice = null;
            error = selected is null ? "Kaynak bulunamadı." : null;
            confirmDelete = false;
            ClearInvalidSshSelection();
            focusOnRender = true;
        }
        catch (System.Data.Common.DbException) { error = "Kaynak açılamadı."; }
        finally { busy = false; }
    }

    private IEnumerable<Resource> SshServers(Resource item) => rows.Where(host =>
        host.Kind == ResourceKind.SshServer && host.Id != item.Id && host.ProjectId == item.ProjectId &&
        !string.IsNullOrEmpty(item.ProjectId));

    private void SourceTypeChanged()
    {
        ClearInvalidSshSelection();
        ClearCredential();
        gitUsesToken = false;
        if (selected is { } item)
            item.Username = item.Kind == ResourceKind.SshServer ? "root" : null;
    }

    private void ClearCredential() => credential = null;

    private void ClearInvalidSshSelection()
    {
        if (selected is { SshServerId: not null } item &&
            (item.Kind != ResourceKind.DeploymentTarget || !SshServers(item).Any(host => host.Id == item.SshServerId)))
            item.SshServerId = null;
    }

    private void CancelEditor()
    {
        if (busy) return;
        ResetEditor();
        error = notice = null;
        focusOnRender = true;
    }

    private void ResetEditor()
    {
        selected = null;
        savedName = credential = null;
        confirmDelete = returnToDeleteButton = gitUsesToken = false;
    }

    private void ConfirmDelete()
    {
        if (busy || savedName is null) return;
        confirmDelete = focusOnRender = true;
        error = null;
    }

    private void CancelDelete()
    {
        if (busy) return;
        confirmDelete = false;
        error = null;
        focusOnRender = returnToDeleteButton = true;
    }

    private async Task DeleteAsync()
    {
        if (busy || !confirmDelete || selected is not { } item || savedName is null) return;
        busy = true;
        error = null;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            var existing = await db.Resources.SingleOrDefaultAsync(x => x.Id == item.Id)
                ?? throw new InvalidOperationException("Kaynak artık bulunamıyor.");
            if (existing.Name != savedName)
                throw new InvalidOperationException("Kaynağın adı değişti. Silmeden önce kaynağı yeniden açın.");
            if (await HasDeploymentTargetsAsync(db, item.Id))
                throw new InvalidOperationException("Bu SSH kaynağına bağlı dağıtım hedeflerini önce değiştirin veya silin.");

            var now = DateTime.UtcNow;
            var approvals = db.Approvals.FromSqlInterpolated($"""
                SELECT * FROM "Approvals"
                WHERE json_extract(CASE WHEN json_valid("Payload") THEN "Payload" END, '$.ResourceId') = {item.Id}
                """);
            if (await approvals.AnyAsync(x => x.Status == "Executing" ||
                ((x.Status == "Pending" || x.Status == "Approved") && x.ExpiresAtUtc > now)))
                throw new InvalidOperationException("Bu kaynakla ilgili bekleyen veya yürütülen bir onay var.");

            db.Resources.Remove(existing);
            db.Events.Add(new Activity { ProjectId = existing.ProjectId, Kind = "ResourceDeleted", Detail = existing.Name });
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            await CompleteMutationAsync("Kaynak silindi.");
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (Exception ex) when (ex is DbUpdateException or System.Data.Common.DbException)
        { error = "Kaynak silinemedi. Kaydı yenileyip yeniden deneyin."; }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        if (busy || confirmDelete || selected is not { } item) return;
        busy = true;
        error = null;
        try
        {
            item.Name = item.Name.Trim();
            item.Address = item.Address.Trim();
            if (item.Name.Length is 0 or > 100 || item.Address.Length is 0 or > 1024)
                throw new ArgumentException("Kaynak adı veya adres geçersiz.");
            await using var db = await Dbs.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            if (!await db.Projects.AnyAsync(x => x.Id == item.ProjectId))
                throw new ArgumentException("Kaynağı var olan bir projeye bağlayın.");
            var existing = await db.Resources.SingleOrDefaultAsync(x => x.Id == item.Id);
            if (existing is null && savedName is not null)
                throw new InvalidOperationException("Kaynak artık bulunamıyor.");
            if (existing is { Kind: ResourceKind.SshServer } && (existing.Kind != item.Kind || existing.ProjectId != item.ProjectId) &&
                await HasDeploymentTargetsAsync(db, item.Id))
                throw new InvalidOperationException("Kaynağın türünü veya projesini değiştirmeden önce bağlı dağıtım hedeflerini düzenleyin.");
            if (item.Kind == ResourceKind.GitRepository) _ = Operations.GitAddress(item);
            if (item.Kind == ResourceKind.DeploymentTarget &&
                (!System.Text.RegularExpressions.Regex.IsMatch(item.Address, @"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}\z") ||
                 !await db.Resources.AnyAsync(x => x.Id == item.SshServerId && x.Id != item.Id && x.Kind == ResourceKind.SshServer && x.ProjectId == item.ProjectId)))
                throw new ArgumentException("Dağıtım için geçerli bir Swarm servis adı ve aynı projede kayıtlı SSH sunucusu gerekli.");
            if (item.Kind == ResourceKind.SshServer)
            {
                item.Username = item.Username?.Trim();
                item.HostFingerprint = item.HostFingerprint?.Trim();
                if (Uri.CheckHostName(item.Address) == UriHostNameType.Unknown || item.Port is < 1 or > 65535 ||
                    string.IsNullOrWhiteSpace(item.Username) || !System.Text.RegularExpressions.Regex.IsMatch(item.HostFingerprint ?? "", @"^SHA256:[a-zA-Z0-9+/]{43}=?$"))
                    throw new ArgumentException("SSH için geçerli bir sunucu adresi, port, kullanıcı adı ve SHA256 parmak izi gerekli.");
                item.SftpFile = string.IsNullOrWhiteSpace(item.SftpFile) ? null : item.SftpFile.Trim();
            }
            else item.SftpFile = null;
            if (item.Kind != ResourceKind.DeploymentTarget) item.SshServerId = null;
            if (Uri.TryCreate(item.Address, UriKind.Absolute, out var address) && address.UserInfo.Length > 0)
                throw new ArgumentException("Adreste erişim bilgisi kullanmayın.");
            var vaultId = existing is not null && existing.Address == item.Address && existing.Kind == item.Kind &&
                existing.ProjectId == item.ProjectId && existing.Username == item.Username && existing.Port == item.Port &&
                existing.HostFingerprint == item.HostFingerprint ? existing.VaultId : null;
            if (item.Kind == ResourceKind.DeploymentTarget || (item.Kind == ResourceKind.GitRepository && !gitUsesToken))
                vaultId = null;
            else if (!string.IsNullOrWhiteSpace(credential))
            {
                var secret = item.Kind == ResourceKind.GitRepository ? credential.Trim() : credential;
                if (item.Kind == ResourceKind.GitRepository && secret.AsSpan().ContainsAny('\r', '\n'))
                    throw new ArgumentException("Git erişim belirteci tek satır olmalı.");
                if (item.Kind == ResourceKind.SshServer)
                    Operations.ValidateSshPrivateKey(secret);
                vaultId = await Vault.StoreAsync(secret, default);
            }
            else if (vaultId is null && (item.Kind == ResourceKind.SshServer || (item.Kind == ResourceKind.GitRepository && gitUsesToken)))
                throw new ArgumentException(item.Kind == ResourceKind.SshServer
                    ? "Bağlantıyı kaydetmek için SSH özel anahtarını girin."
                    : "Özel depo için Git erişim belirtecini girin.");
            item.VaultId = vaultId;
            if (existing is null) db.Resources.Add(item); else db.Entry(existing).CurrentValues.SetValues(item);
            db.Events.Add(new Activity { ProjectId = item.ProjectId, Kind = "ResourceSaved", Detail = item.Name });
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            await CompleteMutationAsync(existing is null ? "Kaynak eklendi." : "Kaynak güncellendi.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException or FormatException or UnauthorizedAccessException or
            DbUpdateException or System.Data.Common.DbException or System.Security.Cryptography.CryptographicException)
        { error = ex is ArgumentException or InvalidOperationException ? ex.Message : "Kaynak veya Vault kaydı yazılamadı."; }
        finally { busy = false; }
    }

    private static Task<bool> HasDeploymentTargetsAsync(PlatformDb db, string id) =>
        db.Resources.AnyAsync(x => x.Kind == ResourceKind.DeploymentTarget && x.SshServerId == id);

    private async Task CompleteMutationAsync(string message)
    {
        ResetEditor();
        notice = message;
        focusOnRender = true;
        try { await LoadAsync(); }
        catch (System.Data.Common.DbException) { error = "Liste yenilenemedi. Sayfayı yenileyin."; }
    }
}
