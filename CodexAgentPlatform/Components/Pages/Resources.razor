@page "/resources"
@attribute [Authorize]
@inject IDbContextFactory<PlatformDb> Dbs
@inject Vault Vault

<PageTitle>Resources · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head"><h1>Resources</h1><button @ref="addButton" class="primary" disabled="@busy" @onclick="NewResource"><Icon Name="plus" /> Add resource</button></header>
    @if (notice is not null) { <p @ref="feedback" class="notice" role="status" tabindex="-1">@notice</p> }
    @if (selected is null && error is not null) { <p class="notice error" role="alert">@error</p> }
    <div class="split-panel">
        <div class="list">
            @foreach (var item in rows)
            {
                <button class="list-row" disabled="@busy" aria-pressed="@(selected?.Id == item.Id ? "true" : "false")" @onclick="() => EditAsync(item.Id)"><span class="avatar" aria-hidden="true"><Icon Name="@ResourceIcon(item.Kind)" /></span>
                    <span class="resource-name"><strong>@item.Name</strong><small>@KindLabel(item.Kind) · @item.Address</small></span>
                    @if (item.IsGlobal) { <span class="global-mark"><Icon Name="star" /> Global</span> }
                </button>
            }
            @if (rows.Count == 0) { <p class="empty">No resources yet.</p> }
        </div>
        @if (selected is not null)
        {
            <form class="card fields" aria-labelledby="resource-editor" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <button type="button" class="editor-back" disabled="@busy" @onclick="CancelEditor"><Icon Name="chevron" /> Resource list</button>
                <h2 id="resource-editor" @ref="editorHeading" tabindex="-1">@(savedName is null ? "New resource" : "Edit resource")</h2>
                <label>Resource name <input @bind="selected.Name" maxlength="100" required disabled="@busy" /></label>
                <label>Type <select @bind="selected.Kind" @bind:after="SourceTypeChanged" disabled="@busy">@foreach (var kind in Enum.GetValues<ResourceKind>()) { <option value="@kind">@KindLabel(kind)</option> }</select></label>
                <fieldset class="scope-picker" disabled="@busy"><legend>Scope</legend>
                    <label><input name="resource-scope" type="radio" checked="@(!selected.IsGlobal)" @onchange="() => SetScope(false)" /><Icon Name="folder" /> Project-specific</label>
                    <label><input name="resource-scope" type="radio" checked="@selected.IsGlobal" @onchange="() => SetScope(true)" /><Icon Name="star" /> Global</label>
                </fieldset>
                @if (!selected.IsGlobal)
                {
                <label>Project
                    <select @bind="selected.ProjectId" @bind:after="ClearInvalidSshSelection" required disabled="@busy">
                        <option value="">Select a project</option>
                        @foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }
                    </select>
                </label>
                }
                <label>@(selected.Kind switch { ResourceKind.SshServer => "Hostname or IP", ResourceKind.GitRepository => "HTTPS repository URL", ResourceKind.DeploymentTarget => "Docker Swarm service name", _ => "Address" })
                    <input @bind="selected.Address" maxlength="1024" required disabled="@busy" /></label>
                @if (selected.Kind == ResourceKind.GitRepository)
                {
                    <label class="check"><input type="checkbox" @bind="gitUsesToken" @bind:after="ClearCredential" disabled="@busy" /> Private repository (use an HTTPS access token)</label>
                    @if (gitUsesToken)
                    {
                        <label>Connection
                            <select @bind="selected.ConnectionSourceId" @bind:after="ClearCredential" disabled="@busy">
                                <option value="">Enter a token for this repository</option>
                                @foreach (var source in GitConnections(selected))
                                {
                                    <option value="@source.Id">@source.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (gitUsesToken && string.IsNullOrEmpty(selected.ConnectionSourceId))
                    {
                        <label>Git username (optional) <input @bind="selected.Username" maxlength="120" disabled="@busy" /></label>
                        <label>Git access token (PAT)
                            <input type="password" @bind="credential" maxlength="65536" autocomplete="new-password" required="@(Vault.Configured && selected.VaultId is null)" disabled="@(busy || !Vault.Configured)" />
                        </label>
                    }
                }
                @if (selected.Kind != ResourceKind.GitRepository && selected.ConnectionSourceId is { Length: > 0 } connectionId)
                {
                    <p class="muted">Saved connection · @rows.FirstOrDefault(r => r.Id == connectionId)?.Name</p>
                    <button type="button" class="button" disabled="@busy" @onclick="() => selected.ConnectionSourceId = null">Use a separate credential</button>
                }
                @if (selected.Kind == ResourceKind.SshServer)
                {
                    <label>SSH username <input @bind="selected.Username" maxlength="120" required disabled="@busy" /></label>
                    <label>SSH port <input type="number" @bind="sshPort" min="1" max="65535" required disabled="@busy" /></label>
                    <label>Host key fingerprint <input @bind="selected.HostFingerprint" placeholder="SHA256:…" maxlength="512"
                        aria-describedby="host-fingerprint-help" required disabled="@busy" /></label>
                    <small id="host-fingerprint-help" class="muted">Use the server's verified SHA256 fingerprint or paste the output of <code>ssh-keygen -lf</code> for the server's host key.</small>
                    @if (selected.ConnectionSourceId is null)
                    {
                    <label>SSH private key
                        <textarea @bind="credential" rows="4" spellcheck="false" autocomplete="off" maxlength="65536" required="@(Vault.Configured && selected.VaultId is null)" disabled="@(busy || !Vault.Configured)"></textarea>
                    </label>
                    <small class="muted">Enter the complete private key without a passphrase. Add the public key (.pub) to this user's authorized_keys file on the remote server.</small>
                    }
                    <label>SFTP text file (optional) <input @bind="selected.SftpFile" placeholder="/srv/reports/status.txt" maxlength="512" disabled="@busy" /></label>
                }
                @if (selected.Kind == ResourceKind.DeploymentTarget)
                {
                    var hosts = SshServers(selected).ToArray();
                    <label>SSH server
                        <select @bind="selected.SshServerId" required disabled="@busy" aria-describedby="source-ssh-help">
                            <option value="">Select</option>
                            @foreach (var host in hosts)
                            { <option value="@host.Id">@host.Name</option> }
                        </select>
                    </label>
                    <small id="source-ssh-help" class="muted">
                        @(hosts.Length == 0 ? "Add an SSH server for this scope first." : "Showing SSH servers available to this target.")
                    </small>
                }
                @if (selected.ConnectionSourceId is null && selected.Kind is not (ResourceKind.DeploymentTarget or ResourceKind.GitRepository or ResourceKind.SshServer) && Vault.Configured)
                {
                    <label>New vault secret
                        <textarea @bind="credential" rows="3" autocomplete="off" maxlength="65536" disabled="@busy"></textarea>
                    </label>
                }
                @if (selected.Kind != ResourceKind.DeploymentTarget && (selected.Kind != ResourceKind.GitRepository || gitUsesToken))
                {
                    @if (!Vault.Configured)
                    {
                        <small class="muted">Configure Platform__VaultKeyFile on the server to store secrets.</small>
                    }
                    else if (selected.VaultId is not null)
                    {
                        <small class="muted">Leave this field blank to keep the saved credential when the connection details are unchanged.</small>
                    }
                }
                <label class="check"><input type="checkbox" @bind="selected.Production" disabled="@busy" /> Production resource</label>
                @if (error is not null) { <p class="notice error" role="alert">@error</p> }
                @if (confirmDelete)
                {
                    <div class="notice error fields" role="group" aria-labelledby="resource-delete-title">
                        <strong id="resource-delete-title" @ref="confirmationHeading" tabindex="-1">Delete the resource “@savedName”?</strong>
                        <div class="actions">
                            <button class="button" type="button" disabled="@busy" @onclick="CancelDelete">Cancel</button>
                            <button class="button danger" type="button" disabled="@busy" @onclick="DeleteAsync">Delete resource</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="actions">
                        <button class="primary" type="submit" disabled="@busy">Save</button>
                        <button class="button" type="button" disabled="@busy" @onclick="CancelEditor">Cancel</button>
                        @if (savedName is not null)
                        {
                            <button @ref="deleteButton" class="button danger" type="button" disabled="@busy" @onclick="ConfirmDelete">Delete</button>
                        }
                    </div>
                }
            </form>
        }
    </div>
</section>

@code {
    private static string KindLabel(ResourceKind kind) => kind switch
    {
        ResourceKind.GitRepository => "Git repository", ResourceKind.SshServer => "SSH server",
        ResourceKind.DeploymentTarget => "Deployment target", ResourceKind.LocalWorkspace => "Local workspace",
        ResourceKind.Environment => "Environment", ResourceKind.ApiConnection => "API connection", _ => "External service"
    };

    private static string ResourceIcon(ResourceKind kind) => kind switch
    {
        ResourceKind.GitRepository => "branch",
        ResourceKind.SshServer => "server",
        ResourceKind.LocalWorkspace => "folder",
        ResourceKind.DeploymentTarget => "box",
        ResourceKind.Environment => "settings",
        _ => "link"
    };

    private List<Resource> rows = [];
    private List<Project> projects = [];
    private Resource? selected;
    private string? credential, error, notice, savedName;
    private string sshPort = "22";
    private bool busy, confirmDelete, focusOnRender, returnToDeleteButton, gitUsesToken;
    private ElementReference addButton, editorHeading, confirmationHeading, deleteButton, feedback;
    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusOnRender) return;
        focusOnRender = false;
        var target = returnToDeleteButton ? deleteButton
            : selected is not null ? (confirmDelete ? confirmationHeading : editorHeading)
            : (notice is not null ? feedback : addButton);
        returnToDeleteButton = false;
        try { await target.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task LoadAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        rows = await db.Resources.AsNoTracking().OrderByDescending(x => x.IsGlobal).ThenBy(x => x.Name).ToListAsync();
        projects = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    private void NewResource()
    {
        if (busy) return;
        CancelEditor();
        selected = new() { IsGlobal = projects.Count == 0 };
        sshPort = selected.Port.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task EditAsync(string id)
    {
        if (busy) return;
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            selected = await db.Resources.AsNoTracking().SingleOrDefaultAsync(x => x.Id == id);
            savedName = selected?.Name;
            sshPort = selected?.Port.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "22";
            gitUsesToken = selected?.Kind == ResourceKind.GitRepository && (selected.VaultId != null || selected.ConnectionSourceId != null);
            credential = notice = null;
            error = selected is null ? "Resource not found." : null;
            confirmDelete = false;
            ClearInvalidSshSelection();
            focusOnRender = true;
        }
        catch (System.Data.Common.DbException) { error = "Could not open the resource."; }
        finally { busy = false; }
    }

    private IEnumerable<Resource> SshServers(Resource item) => rows.Where(host =>
        host.Kind == ResourceKind.SshServer && host.Id != item.Id &&
        (host.IsGlobal || (item.ProjectId is not null && item.ProjectId == host.ProjectId)));

    private IEnumerable<Resource> GitConnections(Resource item) => rows.Where(source => source.Kind == ResourceKind.GitRepository &&
        source.Id != item.Id && source.VaultId != null && source.ConnectionSourceId == null &&
        (source.IsGlobal || item.ProjectId != null && item.ProjectId == source.ProjectId));

    private void SetScope(bool global)
    {
        if (selected is not { } item) return;
        item.IsGlobal = global;
        if (global) item.ProjectId = null;
        ClearInvalidSshSelection();
    }

    private void SourceTypeChanged()
    {
        ClearInvalidSshSelection();
        ClearCredential();
        gitUsesToken = false;
        if (selected is { } item)
        {
            item.ConnectionSourceId = null;
            item.Username = item.Kind == ResourceKind.SshServer ? "root" : null;
        }
    }

    private void ClearCredential() => credential = null;

    private void ClearInvalidSshSelection()
    {
        if (selected is { SshServerId: not null } item &&
            (item.Kind != ResourceKind.DeploymentTarget || !SshServers(item).Any(host => host.Id == item.SshServerId)))
            item.SshServerId = null;
    }

    private void CancelEditor()
    {
        if (busy) return;
        ResetEditor();
        error = notice = null;
        focusOnRender = true;
    }

    private void ResetEditor()
    {
        selected = null;
        savedName = credential = null;
        confirmDelete = returnToDeleteButton = gitUsesToken = false;
    }

    private void ConfirmDelete()
    {
        if (busy || savedName is null) return;
        confirmDelete = focusOnRender = true;
        error = null;
    }

    private void CancelDelete()
    {
        if (busy) return;
        confirmDelete = false;
        error = null;
        focusOnRender = returnToDeleteButton = true;
    }

    private async Task DeleteAsync()
    {
        if (busy || !confirmDelete || selected is not { } item || savedName is null) return;
        busy = true;
        error = null;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            var existing = await db.Resources.SingleOrDefaultAsync(x => x.Id == item.Id)
                ?? throw new InvalidOperationException("This resource no longer exists.");
            if (existing.Name != savedName)
                throw new InvalidOperationException("The resource was renamed. Reopen it before deleting.");
            if (await HasDeploymentTargetsAsync(db, item.Id))
                throw new InvalidOperationException("Update or delete the deployment targets linked to this SSH resource first.");
            if (await db.Resources.AnyAsync(r => r.ConnectionSourceId == item.Id))
                throw new InvalidOperationException("Update the resources using this saved connection before deleting it.");

            var now = DateTime.UtcNow;
            var approvals = db.Approvals.FromSqlInterpolated($"""
                SELECT * FROM "Approvals"
                WHERE json_extract(CASE WHEN json_valid("Payload") THEN "Payload" END, '$.ResourceId') = {item.Id}
                """);
            if (await approvals.AnyAsync(x => x.Status == "Executing" ||
                ((x.Status == "Pending" || x.Status == "Approved") && x.ExpiresAtUtc > now)))
                throw new InvalidOperationException("This resource has a pending or executing approval.");

            db.Resources.Remove(existing);
            db.Events.Add(new Activity { ProjectId = existing.ProjectId, Kind = "ResourceDeleted", Detail = existing.Name });
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            await CompleteMutationAsync("Resource deleted.");
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (Exception ex) when (ex is DbUpdateException or System.Data.Common.DbException)
        { error = "Could not delete the resource. Refresh the record and try again."; }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        if (busy || confirmDelete || selected is not { } item) return;
        busy = true;
        error = null;
        try
        {
            item.Name = item.Name.Trim();
            item.Address = item.Address.Trim();
            if (item.Name.Length is 0 or > 100)
                throw new ArgumentException("Enter a resource name between 1 and 100 characters.");
            if (item.Address.Length is 0 or > 1024)
                throw new ArgumentException("Enter a resource address between 1 and 1,024 characters.");
            await using var db = await Dbs.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            if (item.IsGlobal) item.ProjectId = null;
            else if (!await db.Projects.AnyAsync(x => x.Id == item.ProjectId))
                throw new ArgumentException("Assign the resource to an existing project.");
            var existing = await db.Resources.SingleOrDefaultAsync(x => x.Id == item.Id);
            if (existing is null && savedName is not null)
                throw new InvalidOperationException("This resource no longer exists.");
            if (existing is { Kind: ResourceKind.SshServer } && (existing.Kind != item.Kind || existing.ProjectId != item.ProjectId || existing.IsGlobal != item.IsGlobal) &&
                await HasDeploymentTargetsAsync(db, item.Id))
                throw new InvalidOperationException("Update linked deployment targets before changing the resource type or project.");
            if (item.Kind == ResourceKind.GitRepository) _ = Operations.GitAddress(item);
            if (item.Kind == ResourceKind.DeploymentTarget)
            {
                if (!Operations.IsSwarmServiceName(item.Address))
                    throw new ArgumentException("Enter the Docker Swarm service name, such as app_web.");
                if (!await db.Resources.AnyAsync(x => x.Id == item.SshServerId && x.Id != item.Id && x.Kind == ResourceKind.SshServer &&
                    (x.IsGlobal || (item.ProjectId != null && x.ProjectId == item.ProjectId))))
                    throw new ArgumentException("Choose an SSH server available in this scope.");
            }
            if (item.Kind == ResourceKind.SshServer)
            {
                if (!int.TryParse(sshPort, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var port))
                    throw new ArgumentException("Enter the SSH port as a whole number between 1 and 65535.");
                item.Port = port;
                Operations.ValidateSshServer(item);
                item.SftpFile = string.IsNullOrWhiteSpace(item.SftpFile) ? null : item.SftpFile.Trim();
                if (item.SftpFile is { } path && (path.Length > 512 || !Operations.IsSftpFile(path)))
                    throw new ArgumentException("Enter an absolute SFTP text file path, such as /srv/reports/status.txt. Use letters, numbers, dots, hyphens, or underscores in its names.");
            }
            else item.SftpFile = null;
            if (item.Kind != ResourceKind.DeploymentTarget) item.SshServerId = null;
            if (Uri.TryCreate(item.Address, UriKind.Absolute, out var address) && address.UserInfo.Length > 0)
                throw new ArgumentException("Keep credentials out of the address.");
            var vaultId = existing is not null && existing.Address == item.Address && existing.Kind == item.Kind &&
                existing.IsGlobal == item.IsGlobal && existing.ProjectId == item.ProjectId && existing.Username == item.Username && existing.Port == item.Port &&
                existing.HostFingerprint?.TrimEnd('=') == item.HostFingerprint?.TrimEnd('=') ? existing.VaultId : null;
            if (item.Kind == ResourceKind.DeploymentTarget || (item.Kind == ResourceKind.GitRepository && !gitUsesToken))
            {
                item.ConnectionSourceId = null;
                vaultId = null;
            }
            else if (!string.IsNullOrEmpty(item.ConnectionSourceId))
            {
                var source = await db.Resources.AsNoTracking().SingleOrDefaultAsync(r => r.Id == item.ConnectionSourceId);
                ResourceRegistration.ValidateConnection(item, source);
                item.Username = source!.Username;
                vaultId = null;
            }
            else if (!string.IsNullOrWhiteSpace(credential))
            {
                var secret = item.Kind == ResourceKind.GitRepository ? credential.Trim() : credential;
                if (item.Kind == ResourceKind.GitRepository && secret.AsSpan().ContainsAny('\r', '\n'))
                    throw new ArgumentException("The Git access token must be a single line.");
                if (item.Kind == ResourceKind.SshServer)
                    Operations.ValidateSshPrivateKey(secret);
                vaultId = await Vault.StoreAsync(secret, default);
            }
            else if (vaultId is null && (item.Kind == ResourceKind.SshServer || (item.Kind == ResourceKind.GitRepository && gitUsesToken)))
                throw new ArgumentException(item.Kind == ResourceKind.SshServer
                    ? "Enter the SSH private key to save the connection."
                    : "Enter a Git access token for the private repository.");
            item.VaultId = vaultId;
            if (string.IsNullOrEmpty(item.ConnectionSourceId)) item.ConnectionSourceId = null;
            if (existing is null) db.Resources.Add(item); else db.Entry(existing).CurrentValues.SetValues(item);
            db.Events.Add(new Activity { ProjectId = item.ProjectId, Kind = "ResourceSaved", Detail = item.Name });
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            await CompleteMutationAsync(existing is null ? "Resource added." : "Resource updated.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException or FormatException or UnauthorizedAccessException or
            DbUpdateException or System.Data.Common.DbException or System.Security.Cryptography.CryptographicException)
        { error = ex is ArgumentException or InvalidOperationException ? ex.Message : "Could not save the resource or vault entry."; }
        finally { busy = false; }
    }

    private static Task<bool> HasDeploymentTargetsAsync(PlatformDb db, string id) =>
        db.Resources.AnyAsync(x => x.Kind == ResourceKind.DeploymentTarget && x.SshServerId == id);

    private async Task CompleteMutationAsync(string message)
    {
        ResetEditor();
        notice = message;
        focusOnRender = true;
        try { await LoadAsync(); }
        catch (System.Data.Common.DbException) { error = "Could not refresh the list. Reload the page."; }
    }
}
