@page "/codex"
@attribute [Authorize]
@implements IDisposable
@inject ICodexConnection Codex
@inject CodexAccounts Accounts
@inject IDbContextFactory<PlatformDb> Dbs
@inject IConfiguration Configuration

<PageTitle>Codex settings · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head"><h1>Codex settings</h1><button class="button" disabled="@busy" @onclick="Inspect">Test connection</button></header>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }
    <div class="stat-grid">
        <div class="card"><span>Codex CLI</span><strong>@(version ?? "Version not checked")</strong></div>
        <div class="card"><span>Local App Server</span><strong>@(Codex.Connected ? "Connected" : "Disconnected")</strong></div>
        <div class="card"><span>ChatGPT session</span><strong>@(accountChecked ? account ?? "Signed out" : "Status not verified")</strong></div>
    </div>
    <article class="card fields">
        <h2>ChatGPT account</h2>
        @if (accountChecked && account is null && loginId is null)
        {
            <p class="muted">You are not signed in to ChatGPT in this application.</p>
        }
        <div class="actions">
            @if (account is null && LoginEnabled)
            {
                <button class="primary" disabled="@(busy || loginId is not null)" @onclick="Connect">Sign in with a device code</button>
            }
            @if (accountChecked && account is not null)
            {
                <button class="button" disabled="@busy" @onclick="Disconnect">Sign out of Codex</button>
            }
            <button class="button" disabled="@busy" @onclick="Reconnect">Reconnect to App Server</button>
        </div>
        @if (verification is not null && code is not null)
        {
            <p><a href="@verification" target="_blank" rel="noopener noreferrer">Open ChatGPT device verification</a> and enter the code <code class="device-code">@(code)</code>.</p>
            <div class="actions"><button class="button" @onclick="CancelLogin">Cancel</button><button class="button" @onclick="Inspect">Refresh status</button></div>
        }
        @if (!LoginEnabled) { <p class="muted">Local ChatGPT sign-in is disabled for this installation.</p> }
    </article>
    @if (OperatingSystem.IsWindows())
    {
        <article class="card fields">
            <h2>Windows sandbox</h2>
            <p>Local file and terminal access status <strong>@(sandboxStatus ?? "Not checked")</strong></p>
            <div class="actions">
                <button class="button" disabled="@busy" @onclick="() => RunAsync(ReadSandboxAsync)">Check status</button>
                @if (sandboxStatus == "updateRequired")
                {
                    <button class="primary" disabled="@(busy || sandboxStarting)" @onclick="SetupSandbox">Set up Windows sandbox</button>
                }
            </div>
        </article>
    }
    @if (prefs is not null)
    {
        <article class="card fields">
            <h2>Default model</h2>
            <p class="muted">@models.Count models available. Changes apply to subsequent messages.</p>
            <div class="fields side-by-side"><ModelFields Models="models" @bind-Model="prefs.Model" @bind-Effort="prefs.Effort" /></div>
            <div><button class="primary" disabled="@busy" @onclick="Save">Save</button></div>
        </article>
    }
    <article class="card">
        <h2>Token usage</h2>
        <div class="data-list"><span>Input <strong>@input.ToString("N0")</strong></span><span>Cached <strong>@cached.ToString("N0")</strong></span><span>Output <strong>@output.ToString("N0")</strong></span><span>Total <strong>@total.ToString("N0")</strong></span></div>
        @if (missingUsage > 0) { <p class="muted">@missingUsage turns have no usage report.</p> }
    </article>
</section>

@code {
    private string? version, account, error, notice, loginId, verification, code;
    private bool busy, accountChecked;
    private bool sandboxStarting;
    private string? sandboxStatus;
    private long input, cached, output, total;
    private int missingUsage;
    private List<CodexModel> models = [];
    private Preferences? prefs;
    private bool LoginEnabled => Configuration.GetValue<bool>("Platform:LocalCodexLogin");

    protected override async Task OnInitializedAsync()
    {
        Codex.Received += OnEvent;
        await using var db = await Dbs.CreateDbContextAsync();
        prefs = await db.Preferences.AsNoTracking().SingleAsync();
        var usage = await db.Usage.GroupBy(x => 1).Select(g => new { Input = g.Sum(x => x.Input), Cache = g.Sum(x => x.Cached),
            Output = g.Sum(x => x.Output), Total = g.Sum(x => x.Total) }).FirstOrDefaultAsync();
        if (usage is not null) (input, cached, output, total) = (usage.Input, usage.Cache, usage.Output, usage.Total);
        missingUsage = await db.Runs.CountAsync(r => r.TurnId != null && !Enumerable.Contains(ChatStore.Active, r.Status) &&
            !db.Usage.Any(u => u.ThreadId == r.ThreadId && u.TurnId == r.TurnId));
        if (Codex.Connected) await RunAsync(ReadAsync);
    }

    private Task Inspect() => RunAsync(async () =>
    {
        await ReadAsync();
        version = await Codex.VersionAsync(default);
        await ReadSandboxAsync();
        notice = "App Server responded.";
    });
    private Task Reconnect() => RunAsync(async () =>
    {
        await using var db = await Dbs.CreateDbContextAsync();
        if (await db.Runs.AnyAsync(x => Enumerable.Contains(ChatStore.Active, x.Status))) throw new InvalidOperationException("Stop active work before reconnecting.");
        ClearCode();
        await Codex.ReconnectAsync(default);
        await ReadAsync();
        version = await Codex.VersionAsync(default);
        await ReadSandboxAsync();
    });

    private Task Connect() => RunAsync(async () =>
    {
        if (!LoginEnabled) return;
        var result = await Accounts.LoginAsync(default);
        if (!Uri.TryCreate(result.String("verificationUrl"), UriKind.Absolute, out var uri) ||
            uri.Scheme != "https" || uri.Host != "auth.openai.com")
            throw new InvalidOperationException("Unexpected device verification URL.");
        verification = uri.AbsoluteUri;
        code = result.String("userCode");
        loginId = result.String("loginId");
    });

    private Task CancelLogin() => RunAsync(async () => { if (loginId is { } id) await Accounts.CancelAsync(id, default); ClearCode(); });
    private Task Disconnect() => RunAsync(async () =>
    {
        await using var db = await Dbs.CreateDbContextAsync();
        if (await db.Runs.AnyAsync(x => Enumerable.Contains(ChatStore.Active, x.Status))) throw new InvalidOperationException("Stop active work before signing out of Codex.");
        accountChecked = false;
        await Accounts.LogoutAsync(default);
        ClearCode();
        await ReadAccountAsync();
        if (account is not null) throw new InvalidOperationException("Codex still reports an active account session.");
        notice = "Signed out of Codex in this application.";
        models = await Accounts.ModelsAsync(default);
    });

    private async Task ReadAsync()
    {
        await ReadAccountAsync();
        models = await Accounts.ModelsAsync(default);
    }

    private async Task ReadAccountAsync()
    {
        accountChecked = false;
        var result = (await Accounts.ReadAsync(default)).Get("account");
        if (result.ValueKind is not (System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Object))
            throw new InvalidOperationException("Could not verify the Codex account status.");
        account = result.String("planType") is { } plan ? $"ChatGPT · {plan}" : result.String("type");
        accountChecked = true;
        if (account is not null) ClearCode();
    }

    private async Task ReadSandboxAsync()
    {
        if (OperatingSystem.IsWindows())
            sandboxStatus = (await Accounts.WindowsReadinessAsync(default)).String("status");
    }

    private Task SetupSandbox() => RunAsync(async () =>
    {
        await ReadSandboxAsync();
        if (sandboxStatus != "updateRequired") return;
        sandboxStarting = (await Accounts.WindowsSetupAsync(default)).True("started");
        if (sandboxStarting) notice = "Windows sandbox setup has started. Complete the Windows approval prompt on the server.";
    });

    private Task Save() => RunAsync(async () =>
    {
        if (prefs is null) return;
        await using var db = await Dbs.CreateDbContextAsync();
        await db.Preferences.ExecuteUpdateAsync(s => s.SetProperty(x => x.Model, prefs.Model)
            .SetProperty(x => x.Effort, prefs.Effort));
        notice = "Model preferences saved.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null; notice = null;
        try { await action(); }
        catch (Exception ex)
        {
            error = ex switch
            {
                CodexRpcException or InvalidOperationException or TimeoutException => ex.Message,
                UnauthorizedAccessException => "Cannot access the Codex working directory. Check the application's data directory permissions.",
                IOException => "The Codex App Server connection failed or was interrupted. Reconnect and test the connection.",
                _ => "The Codex settings operation failed. Check the application logs."
            };
        }
        finally { busy = false; }
    }

    private void OnEvent(CodexEvent item)
    {
        if (item.Method == "windowsSandbox/setupCompleted")
        {
            _ = InvokeAsync(async () =>
            {
                sandboxStarting = false;
                await RunAsync(ReadSandboxAsync);
                if (item.Parameters.True("success")) notice = "Windows sandbox setup completed.";
                else error = item.Parameters.String("error") ?? "Windows sandbox setup failed.";
                StateHasChanged();
            });
            return;
        }
        if (item.Method != "account/login/completed") return;
        _ = InvokeAsync(async () =>
        {
            if (item.Parameters.String("loginId") != loginId) return;
            ClearCode();
            if (item.Parameters.True("success")) await RunAsync(ReadAsync);
            else error = "Device verification failed.";
            StateHasChanged();
        });
    }

    private void ClearCode() => (loginId, verification, code) = (null, null, null);
    public void Dispose() => Codex.Received -= OnEvent;
}
