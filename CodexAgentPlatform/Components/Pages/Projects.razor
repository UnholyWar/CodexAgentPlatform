@page "/projects"
@attribute [Authorize]
@inject IDbContextFactory<PlatformDb> Dbs
@inject ChatUpdates Updates

<PageTitle>Projects · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head">
        <h1>Projects</h1>
        <button class="primary" disabled="@busy" @ref="addButton" @onclick="NewProject"><Icon Name="plus" /> Add project</button>
    </header>
    @if (notice is not null) { <p class="notice" role="status">@notice</p> }
    <div class="split-panel">
        <div class="list">
            @foreach (var project in rows)
            {
                <button class="list-row" disabled="@busy" @onclick="() => Select(project)"><span class="avatar" aria-hidden="true"><Icon Name="folder" /></span>
                    <span><strong>@project.Name</strong><small>@project.DefaultBranch</small></span></button>
            }
            @if (rows.Count == 0) { <p class="empty">No projects yet.</p> }
        </div>
        @if (selected is not null)
        {
            <form class="card fields" @onsubmit="SaveAsync" @onsubmit:preventDefault aria-labelledby="project-editor">
                <button type="button" class="editor-back" disabled="@busy" @onclick="CloseEditor"><Icon Name="chevron" /> Project list</button>
                <h2 id="project-editor" tabindex="-1" @ref="editorHeading">@(isNew ? "New project" : "Edit project")</h2>
                <label>Project name <input @bind="selected.Name" maxlength="80" required disabled="@busy" /></label>
                <label>Default branch <input @bind="selected.DefaultBranch" maxlength="150" required disabled="@busy" /></label>
                @if (error is not null) { <p class="notice error" role="alert">@error</p> }
                @if (confirmDelete)
                {
                    <div class="fields" role="group" aria-labelledby="project-delete-confirmation">
                        <p id="project-delete-confirmation" tabindex="-1" @ref="deleteConfirmation">Delete the project “@originalName”?</p>
                        <small>Deleting this project also removes its agent permissions.</small>
                        <div class="actions">
                            <button class="button" type="button" disabled="@busy" @onclick="CancelDelete">Cancel</button>
                            <button class="button danger" type="button" disabled="@busy" @onclick="DeleteAsync">Delete project</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="actions">
                        <button class="primary" type="submit" disabled="@busy">Save</button>
                        <button class="button" type="button" disabled="@busy" @onclick="CloseEditor">Cancel</button>
                        @if (!isNew)
                        {
                            <a class="button" href="/resources">View resources</a>
                            <button class="button danger" type="button" disabled="@busy" @onclick="AskToDelete">Delete</button>
                        }
                    </div>
                }
            </form>
        }
    </div>
</section>

@code {
    private List<Project> rows = [];
    private Project? selected;
    private string? originalName, error, notice;
    private bool busy, isNew, confirmDelete, focusEditor, focusAdd, focusConfirmation;
    private ElementReference editorHeading, addButton, deleteConfirmation;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusEditor)
        {
            focusEditor = false;
            await editorHeading.FocusAsync();
        }
        if (focusAdd)
        {
            focusAdd = false;
            await addButton.FocusAsync();
        }
        if (focusConfirmation)
        {
            focusConfirmation = false;
            await deleteConfirmation.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        rows = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    private void NewProject() => OpenEditor(new Project(), true);

    private void Select(Project project) =>
        OpenEditor(new Project { Id = project.Id, Name = project.Name, DefaultBranch = project.DefaultBranch }, false);

    private void OpenEditor(Project project, bool creating)
    {
        selected = project;
        originalName = project.Name;
        isNew = creating;
        error = notice = null;
        confirmDelete = false;
        focusEditor = true;
    }

    private void CloseEditor()
    {
        selected = null;
        error = null;
        confirmDelete = false;
        focusAdd = true;
    }

    private void AskToDelete()
    {
        error = null;
        confirmDelete = focusConfirmation = true;
    }

    private void CancelDelete() => confirmDelete = false;

    private async Task SaveAsync()
    {
        if (busy || confirmDelete || selected is not { } draft) return;
        error = null;
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            if (isNew)
                await ProjectStore.CreateAsync(db, draft.Name, draft.DefaultBranch, null, default);
            else
            {
                ProjectStore.Normalize(draft);
                var row = await db.Projects.FindAsync(draft.Id);
                if (row is null) { error = "This project no longer exists."; return; }
                (row.Name, row.DefaultBranch) = (draft.Name, draft.DefaultBranch);
                await db.SaveChangesAsync();
            }
            await LoadAsync();
            notice = "Project saved.";
            CloseEditor();
        }
        catch (DbUpdateException ex) when (ex.InnerException is Microsoft.Data.Sqlite.SqliteException { SqliteExtendedErrorCode: 2067 })
        { error = "This project name is already in use."; }
        catch (ArgumentException ex) { error = ex.Message; }
        catch (DbUpdateException) { error = "Could not save the project."; }
        finally { busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (busy || isNew || !confirmDelete || selected is not { } draft) return;
        busy = true;
        error = null;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            error = await ProjectStore.DeleteAsync(db, draft.Id, originalName, default);
            if (error is not null) return;
            Updates.Publish("");
            await LoadAsync();
            notice = "Project deleted.";
            CloseEditor();
        }
        catch (Exception ex) when (ex is DbUpdateException or Microsoft.Data.Sqlite.SqliteException)
        { error = "Could not delete the project. Try again."; }
        finally { busy = false; }
    }
}
