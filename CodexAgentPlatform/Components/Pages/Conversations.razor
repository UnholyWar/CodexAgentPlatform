@page "/conversations"
@attribute [Authorize]
@inject ChatStore Chats
@inject AuthenticationStateProvider Authentication
@inject PlatformPaths Paths
@inject ConversationListState Saved
@inject IJSRuntime JS

<PageTitle>Conversations · Codex Agent Platform</PageTitle>
<section class="admin-page">
    <header class="section-head"><h1>Conversations</h1><a class="primary" href="/"><Icon Name="plus" /> New chat</a></header>
    <form class="filter list-filter" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <input placeholder="Search titles and messages" aria-label="Search conversations" @bind="query" maxlength="120" />
        <button class="button" disabled="@busy"><Icon Name="search" /> Search</button>
        <label><input type="checkbox" @bind="archived" @bind:after="SearchAsync" disabled="@busy" /> Archived conversations</label>
    </form>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (result is not null) { <p role="status">@result</p> }
    <div class="list">
        @foreach (var chat in rows)
        {
            <div class="conversation-entry" @key="chat.Id">
                <a data-conversation="@chat.Id" class="list-row history-row" href="/chat/@chat.Id"><span class="avatar" aria-hidden="true"><Icon Name="chat" /></span>
                    <strong>@chat.Title</strong><small>@chat.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</small>
                </a>
                <button class="button quick-action" disabled="@busy" @onclick="() => ArchiveAsync(chat)">@(chat.Archived ? "Restore" : "Archive")</button>
                <button class="icon-button" aria-label="Actions for @chat.Title" aria-expanded="@(menu == chat.Id ? "true" : "false")"
                        disabled="@busy" @onclick="() => ToggleMenu(chat.Id)">…</button>
                @if (menu == chat.Id)
                {
                    <div class="conversation-actions">
                        <button class="button" disabled="@busy" @onclick="() => AskFinish(chat.Id)">Finish conversation</button>
                        <button class="button" disabled="@busy" @onclick="() => AskDelete(chat.Id)">Delete</button>
                    </div>
                }
                @if (finish == chat.Id)
                {
                    <div class="conversation-actions" role="group" aria-label="Confirm finish">
                        <p>Finish “@chat.Title” and cancel its open tasks, queued responses and pending approvals? Your chat history will be kept.</p>
                        <button class="button" disabled="@busy" @onclick="Cancel">Cancel</button>
                        <button class="button" disabled="@busy" @onclick="() => FinishAsync(chat)">Finish conversation</button>
                    </div>
                }
                @if (confirm == chat.Id)
                {
                    <div class="conversation-actions" role="group" aria-label="Confirm deletion">
                        <p>Permanently delete “@chat.Title”? Its messages and attachments will be permanently removed.</p>
                        <button class="button" disabled="@busy" @onclick="Cancel">Cancel</button>
                        <button class="button danger" disabled="@busy" @onclick="() => DeleteAsync(chat.Id)">Permanently delete</button>
                    </div>
                }
            </div>
        }
        @if (rows.Count == 0) { <p class="empty">No conversations found.</p> }
    </div>
</section>

@code {
    private List<Conversation> rows = [];
    private string? query, menu, confirm, finish, result, error;
    private bool archived, busy;
    private int revision;

    private bool restore;
    protected override async Task OnInitializedAsync()
    {
        query = Saved.Query;
        archived = Saved.Archived;
        await SearchAsync();
        restore = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restore) return;
        restore = false;
        await JS.InvokeVoidAsync("restoreConversationPosition");
    }

    private async Task SearchAsync()
    {
        Saved.Query = query;
        Saved.Archived = archived;
        var request = ++revision;
        Cancel();
        var found = await Chats.RecentAsync(query, default, archived);
        if (request == revision) rows = found;
    }

    private void Cancel() { menu = confirm = finish = result = error = null; }
    private void ToggleMenu(string id) { confirm = finish = result = error = null; menu = menu == id ? null : id; }
    private void AskFinish(string id) { Cancel(); finish = id; }

    private async Task FinishAsync(Conversation chat)
    {
        if (busy || finish != chat.Id) return;
        busy = true;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            var ownerId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            var summary = await Chats.FinishConversationAsync(chat.Id, ownerId, default);
            Cancel();
            result = $"Finished “{chat.Title}”. {summary}";
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void AskDelete(string id) { menu = error = null; confirm = id; }

    private async Task ArchiveAsync(Conversation chat)
    {
        if (busy) return;
        busy = true;
        try
        {
            await Chats.SetArchivedAsync(chat.Id, !chat.Archived, default);
            await SearchAsync();
        }
        finally { busy = false; }
    }

    private async Task DeleteAsync(string id)
    {
        if (busy || confirm != id) return;
        busy = true;
        try
        {
            error = await Chats.DeleteConversationAsync(id, Paths, default);
            if (error is null) await SearchAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            error = "Could not remove this conversation’s stored files. Check storage access and try again.";
        }
        finally { busy = false; }
    }
}
