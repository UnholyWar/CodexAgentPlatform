@page "/"
@page "/chat/{Id}"
@attribute [Authorize]
@implements IDisposable
@inject ChatStore Chats
@inject ChatUpdates Updates
@inject Operations Operations
@inject AuthenticationStateProvider Authentication
@inject ChatWorker Worker
@inject IDbContextFactory<PlatformDb> Dbs
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Chat · Codex Agent Platform</PageTitle>
<section class="chat-shell">
    <header class="page-bar">
        <button class="icon-button chat-menu" type="button" popovertarget="mobile-menu" aria-label="Open menu"><Icon Name="menu" /></button>
        <div class="page-heading"><Icon Name="chat" /><div class="chat-title"><h1>@Title</h1>
            <small>@AgentName(ReplyAgentId)@(AutoApprove ? " · Auto-approval enabled" : "")</small></div></div>
        <div class="actions">
            <button type="button" class="icon-button settings-launch" aria-label="Chat settings" title="Chat settings" aria-haspopup="dialog" @onclick="OpenSettingsAsync"><Icon Name="settings" /></button>
            @if (Id is not null) { <a class="icon-button" href="/" title="New chat" aria-label="New chat"><Icon Name="plus" /></a> }
        </div>
    </header>
    <div class="chat-scroll" id="chat-scroll" @key="Id">
        @if (snapshot.Messages.Count == 0)
        {
            <div class="empty-chat">
                <div class="welcome-panel">
                    <div class="welcome-copy">
                        <h2>What are we working on today?</h2>
                        <p>Ask a question or describe what you want to work on.</p>
                    </div>
                    <img class="orbit-art" src="@Assets["orbit.svg"]" alt="" />
                </div>
                <div class="prompt-row">
                    <button @onclick='() => ChoosePromptAsync("Developer, write a small calculator in Python and test it.")'>
                        <span class="prompt-icon"><Icon Name="code" /></span><span><strong>Write code</strong><small>Build a Python calculator</small></span><Icon Name="arrow" />
                    </button>
                    <button @onclick='() => ChoosePromptAsync("Architect, what did we work on yesterday?")'>
                        <span class="prompt-icon"><Icon Name="memory" /></span><span><strong>Recall past work</strong><small>Find yesterday's work</small></span><Icon Name="arrow" />
                    </button>
                    <button @onclick='() => ChoosePromptAsync("QA, prepare a regression test plan for this project.")'>
                        <span class="prompt-icon"><Icon Name="checklist" /></span><span><strong>Plan tests</strong><small>Create a regression test plan</small></span><Icon Name="arrow" />
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="transcript">
                @if (snapshot.Messages.Count >= limit && limit < 500)
                {
                    <button class="button older" @onclick="LoadOlderAsync">Show earlier messages</button>
                }
                @foreach (var message in snapshot.Messages)
                {
                    <article class="message @message.Role" @key="message.Id">
                        <div class="avatar" aria-hidden="true"><Icon Name="@(message.Role == "user" ? "person" : "agent")" /></div>
                        <div class="message-main">
                            <div class="message-meta">
                                <strong>@(message.Role == "user" ? "You" : message.VoiceProjectId is not null ? "Voice assistant" : AgentName(message.AgentId))</strong>
                                <time datetime="@message.CreatedAtUtc.ToString("O")">@LocalTime(message.CreatedAtUtc)</time>
                            </div>
                            @if (message.Text.Length == 0)
                            {
                                @if (snapshot.Run?.AssistantMessageId == message.Id && IsActive)
                                {
                                    <div class="thinking"><span></span> Preparing a response</div>
                                }
                            }
                            else if (message.Role == "user") { <div class="user-text">@message.Text</div> }
                            else { <MarkdownBody Text="@message.Text" CompactCode="true" /> }
                        </div>
                    </article>
                }
                @if (!string.IsNullOrWhiteSpace(snapshot.Run?.Error))
                {
                    <p class="notice error" role="status">@snapshot.Run.Error</p>
                }
                @if (WorkspaceNotice is { } workspaceNotice)
                {
                    <p class="notice" role="status">@workspaceNotice</p>
                }
                <ChatPermissionGrants Approvals="snapshot.Approvals" />
                @if (snapshot.Approvals.Count(a => a.Kind != AgentPermissionGrants.ApprovalKind && a.Status == "Pending" && a.ExpiresAtUtc > DateTime.UtcNow) is > 0 and var pending)
                {
                    <a class="approval-callout" href="/approvals"><Icon Name="approve" /><strong>@pending operations awaiting approval</strong><Icon Name="chevron" /></a>
                }
                @if (snapshot.Events.Count > 0 || snapshot.Approvals.Count > 0)
                {
                    <ChatActivity @key="Id" Events="snapshot.Events" Approvals="snapshot.Approvals" Zone="zone" />
                }
            </div>
        }
    </div>
    <footer class="composer-zone">
        @if (issue is not null) { <p class="notice error" role="alert">@issue</p> }
        @if (mentionedAgent is not null)
        {
            <button type="button" class="mention-chip" aria-label="@($"Remove mention of {mentionedAgent.Name}")" @onclick="ClearMentionAsync">
                <strong>@@@mentionedAgent.Name</strong><Icon Name="close" />
            </button>
        }
        <form class="composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
            <textarea @ref="composerInput" aria-label="Your message" placeholder="Write a message or @@mention an agent…" aria-autocomplete="list"
                      aria-controls="agent-options" aria-haspopup="listbox" @bind="draft" @bind:event="oninput"
                      maxlength="16000" rows="1" data-send-on-enter="true" enterkeyhint="enter"></textarea>
            <div class="mention-list" id="agent-options" role="listbox" aria-label="Agents" hidden @key="(Id, EffectiveProject, IsActive)">
                @if (!IsActive)
                {
                    @foreach (var agent in agents.Where(a => ToolAccess.AllowsProject(a, EffectiveProject)))
                    {
                        <button @key="agent.Id" type="button" role="option" id="mention-@agent.Id" aria-selected="false" tabindex="-1"
                                data-agent-label="@agent.Name" @onclick="() => mentionedAgent = agent">
                            <strong>@agent.Name</strong><small>@agent.Title</small>
                        </button>
                    }
                }
            </div>
            <ChatVoice ConversationId="@Id" ProjectId="@EffectiveProject" PinProject="@(projectId == "")" SelectedAgent="@(mentionedAgent?.Id ?? selectedAgent)"
                       AutoApprove="@AutoApprove" ConversationOpened="OpenVoiceConversation" />
            @if (IsActive && !ChatStore.IsPauseRequest(draft))
            {
                <button type="button" class="primary send" aria-label="Stop work" title="Stop work" @onclick="PauseAsync"><Icon Name="pause" /></button>
            }
            else
            {
                <button type="submit" class="primary send" aria-label="Send" disabled="@(sending || string.IsNullOrWhiteSpace(draft))"><Icon Name="up" /></button>
            }
        </form>
    </footer>
    <dialog class="chat-sheet settings-sheet" @ref="settingsSheet" aria-labelledby="chat-settings-title" @key="@($"settings-{Id}")">
        <header class="sheet-head"><h2 id="chat-settings-title">Chat settings</h2>
            <form method="dialog"><button class="icon-button" aria-label="Close settings" autofocus><Icon Name="close" /></button></form>
        </header>
        <div class="sheet-body fields">
            <label>Reply as<select @bind="ReplyAgentId" disabled="@IsActive"><option value="@PlatformChat.Id">@PlatformChat.Name</option>
                @foreach (var agent in agents.Where(a => ToolAccess.AllowsProject(a, EffectiveProject))) { <option value="@agent.Id">@agent.Name</option> }
            </select></label>
            @if (projects.Count > 0)
            {
                <label>Project<select @bind="ProjectSelection" disabled="@IsActive"><option value="">No project</option>
                    @foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }
                </select></label>
            }
            <button type="button" class="switch-row" role="switch" aria-label="Auto-approval" aria-describedby="approval-help"
                    aria-checked="@(AutoApprove ? "true" : "false")" disabled="@savingApproval" @onclick="ToggleApprovalAsync">
                <span><Icon Name="approve" /><strong>Auto-approval</strong></span><span class="switch-track" aria-hidden="true"></span>
            </button>
            <p id="approval-help" class="muted">In this chat, the agent can push to its own development branch. Docker restarts and deployments matching operations you previously approved and completed are also approved automatically. Production operations, global resources, and rollbacks require manual approval.</p>
            @if (approvalError is not null) { <p class="notice error" role="alert">@approvalError</p> }
        </div>
    </dialog>
</section>

@code {
    [Parameter] public string? Id { get; set; }
    private ChatSnapshot snapshot = new([], [], null, []);
    private List<Agent> agents = [];
    private List<Project> projects = [];
    private TimeZoneInfo zone = TimeZoneInfo.Utc;
    private string? title, loaded, issue, selectedAgent, projectId;
    private Agent? mentionedAgent;
    private string draft = "";
    private ElementReference composerInput, settingsSheet;
    private bool draftAutoApprove, savingApproval;
    private string? approvalError;
    private bool AutoApprove => Id is null ? draftAutoApprove : snapshot.AutoApprove;
    private string? EffectiveProject
    {
        get
        {
            if (projectId is not null) return projectId == "" ? null : projectId;
            var speech = snapshot.Messages.FindLast(m => m.Role == "user" && m.VoiceProjectId is not null &&
                m.Id > (snapshot.Run?.UserMessageId ?? 0));
            return speech?.VoiceProjectId is { } voiceProject ? (voiceProject == "" ? null : voiceProject) : snapshot.Run?.ProjectId;
        }
    }
    private string ProjectSelection
    {
        get => EffectiveProject ?? "";
        set { projectId = value ?? ""; selectedAgent = null; mentionedAgent = null; }
    }
    private string ReplyAgentId
    {
        get
        {
            var id = selectedAgent ?? (snapshot.Run?.ProjectId == EffectiveProject ? snapshot.Run?.AgentId : null);
            return agents.Any(a => a.Id == id && ToolAccess.AllowsProject(a, EffectiveProject)) ? id! : PlatformChat.Id;
        }
        set { selectedAgent = value; mentionedAgent = null; }
    }

    private async Task ClearMentionAsync()
    {
        mentionedAgent = null;
        await composerInput.FocusAsync(preventScroll: true);
    }

    private async Task OpenSettingsAsync()
    {
        await JS.InvokeVoidAsync("platformChat.openDialog", settingsSheet);
        await LoadChoicesAsync();
    }

    private async Task ToggleApprovalAsync()
    {
        if (savingApproval) return;
        approvalError = null;
        if (Id is not { } chat) { draftAutoApprove = !draftAutoApprove; return; }
        savingApproval = true;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            await Operations.SetAutoApprovalAsync(chat, !snapshot.AutoApprove,
                user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "", default);
            Updates.Publish(chat);
            await RefreshAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or UnauthorizedAccessException)
        { approvalError = "Could not save the auto-approval setting."; }
        finally { savingApproval = false; }
    }
    private int limit = 60;
    private bool sending, disposed, scroll;
    private int refreshQueued;
    private int refreshVersion;
    private bool IsActive => snapshot.Run is { } run && ChatStore.Active.Contains(run.Status);
    private string? WorkspaceNotice => snapshot.Run is { } run
        ? snapshot.Events.FirstOrDefault(entry => entry.Kind == "WorkspaceUnavailable" && entry.AgentId == run.AgentId &&
            entry.EventOccurredAtUtc >= run.CreatedAtUtc)?.Detail
        : null;
    private string Title => title ?? "Chat";

    private async Task ChoosePromptAsync(string text)
    {
        draft = text;
        await composerInput.FocusAsync(preventScroll: true);
    }

    protected override async Task OnInitializedAsync()
    {
        Updates.Changed += OnChange;
        Updates.AnswerChanged += OnAnswer;
        await LoadChoicesAsync();
        await using var db = await Dbs.CreateDbContextAsync();
        zone = TimeZoneInfo.FindSystemTimeZoneById(await db.Preferences.Select(x => x.TimeZone).SingleAsync());
    }

    private async Task LoadChoicesAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        agents = await db.Agents.AsNoTracking().OrderBy(x => x.Name)
            .Select(a => new Agent { Id = a.Id, Name = a.Name, Title = a.Title, AllowedProjects = a.AllowedProjects, Archived = a.Archived })
            .ToListAsync();
        projects = await db.Projects.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loaded != Id)
        {
            loaded = Id;
            mentionedAgent = null;
            selectedAgent = null;
            projectId = null;
            draftAutoApprove = false;
            approvalError = null;
            issue = null;
            limit = 60;
            if (Id is null) { title = null; snapshot = new([], [], null, []); return; }
            await using var db = await Dbs.CreateDbContextAsync();
            title = await db.Conversations.Where(x => x.Id == Id).Select(x => x.Title).SingleOrDefaultAsync();
            if (title is null) { Navigation.NavigateTo("/conversations"); return; }
            await Chats.TouchAsync(Id, default);
            scroll = true;
        }
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scroll) return;
        scroll = false;
        try { await JS.InvokeVoidAsync("platformChat.scroll", "chat-scroll"); }
        catch (JSDisconnectedException) { }
    }

    private async Task RefreshAsync()
    {
        if (Id is not { } id) return;
        var version = ++refreshVersion;
        var result = await Chats.ReadAsync(id, limit, default);
        if (!disposed && Id == id && version == refreshVersion)
        {
            Updates.ApplyAnswer(id, result);
            snapshot = result;
        }
    }

    private async Task SendAsync()
    {
        if (sending || string.IsNullOrWhiteSpace(draft)) return;
        if (IsActive)
        {
            if (Id is { } activeChat && ChatStore.IsPauseRequest(draft))
            {
                await Chats.RecordPauseAsync(activeChat, draft.Trim(), default);
                draft = "";
                await Worker.PauseAsync(activeChat, default);
            }
            return;
        }
        sending = true;
        issue = null;
        try
        {
            var id = await Chats.SendAsync(Id, draft, mentionedAgent?.Id ?? selectedAgent,
                projectId ?? EffectiveProject, default, draftAutoApprove);
            draft = "";
            mentionedAgent = null;
            selectedAgent = null;
            projectId = null;
            scroll = true;
            if (Id != id) Navigation.NavigateTo($"/chat/{id}");
            else await RefreshAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or DbUpdateException)
        { issue = ex is DbUpdateException ? "Could not save the message because of a concurrent operation." : ex.Message; }
        finally { sending = false; }
    }

    private async Task PauseAsync()
    {
        if (Id is not null) await Worker.PauseAsync(Id, default);
    }

    private void OpenVoiceConversation(string id)
    {
        if (Id is null) Navigation.NavigateTo($"/chat/{id}", replace: true);
    }

    private async Task LoadOlderAsync()
    {
        limit = Math.Min(limit + 60, 500);
        await RefreshAsync();
    }

    private void OnAnswer(string id)
    {
        if (disposed || id != Id) return;
        _ = InvokeAsync(() =>
        {
            if (disposed || id != Id) return;
            Updates.ApplyAnswer(id, snapshot);
            scroll = true;
            StateHasChanged();
        });
    }

    private void OnChange(string id)
    {
        if (disposed) return;
        if (id == "")
        {
            _ = InvokeAsync(async () =>
            {
                await LoadChoicesAsync();
                await RefreshAsync();
                if (!disposed) StateHasChanged();
            });
            return;
        }
        if (Id is null || id != Id || Interlocked.Exchange(ref refreshQueued, 1) != 0) return;
        _ = InvokeAsync(async () =>
        {
            Interlocked.Exchange(ref refreshQueued, 0);
            if (disposed) return;
            await RefreshAsync();
            scroll = true;
            StateHasChanged();
        });
    }

    private string AgentName(string? id) => id == PlatformChat.Id ? PlatformChat.Name : agents.Find(a => a.Id == id)?.Name ?? "Codex";
    private string LocalTime(DateTime time) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(time, DateTimeKind.Utc), zone).ToString("dd.MM · HH:mm");
    public void Dispose() { disposed = true; Updates.Changed -= OnChange; Updates.AnswerChanged -= OnAnswer; }
}
