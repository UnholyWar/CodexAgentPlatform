<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["brand.svg"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CodexAgentPlatform.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageMode" />
</head>

<body>
    <Routes @rendermode="PageMode" />
    <ReconnectModal />
    <script src="@Assets["platform.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? PageMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
