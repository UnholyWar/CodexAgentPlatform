@implements IAsyncDisposable
@inject ICodexConnection Codex
@inject ChatStore Chats
@inject ChatWorker Worker
@inject Microsoft.Extensions.Logging.ILogger<ChatVoiceCall> Log
@inject IJSRuntime JS

<button type="button" class="icon-button voice-trigger" aria-label="Start voice call" title="Start voice call"
        aria-haspopup="dialog" @ref="trigger" disabled="@(starting || !audioBound)" @onclick="OpenAsync">
    <Icon Name="voice" />
</button>
<dialog class="voice-dialog" aria-labelledby="voice-title" @ref="dialog" @onclose="EndAsync">
    <header class="voice-header">
        <div>
            <h2 id="voice-title">Voice call</h2>
            @if (speakerName is not null) { <small>Talking to @speakerName</small> }
        </div>
        <button type="button" class="icon-button" aria-label="Close voice call" title="Close voice call" @onclick="CloseAsync">
            <Icon Name="close" />
        </button>
    </header>
    <div class="voice-center">
        <div class="voice-stage" aria-hidden="true">
            <div class="voice-orb">
                <div class="voice-color">
                    <canvas class="voice-orb-canvas"></canvas>
                    <div class="voice-particles">
                        <span></span><span></span>
                    </div>
                    <div class="voice-meteors">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>
        <p class="voice-speaking-agent" role="status" hidden></p>
        <p class="voice-status @(connected && !muted ? "voice-status-hidden" : null)" role="status">@status</p>
        @if (error is not null) { <p class="voice-error" role="alert">@error</p> }
        <p class="voice-error voice-playback-error" role="status" hidden></p>
        @if (call is not null && Approvals.Count > 0)
        {
            <section class="voice-approvals" aria-label="Call approvals">
                @foreach (var approval in Approvals)
                {
                    <ApprovalCard @key="approval.Id" Item="approval" />
                }
            </section>
        }
    </div>
    <footer class="voice-controls">
        <button type="button" class="button voice-play" hidden>Enable sound</button>
        @if (retryReply is not null)
        {
            <button type="button" class="button" @onclick="RetryReplyAsync">Retry audio</button>
        }
        <button type="button" class="icon-button voice-mute" aria-label="Mute microphone" aria-pressed="@(muted ? "true" : "false")"
                disabled="@(!connected)" @onclick="ToggleMuteAsync">
            <Icon Name="microphone" /><span>@(muted ? "Unmute" : "Mute")</span>
        </button>
        <button type="button" class="button voice-end" @onclick="CloseAsync">
            <Icon Name="phone" /> End call
        </button>
    </footer>
</dialog>

@code {
    [Parameter] public string? ConversationId { get; set; }
    [Parameter] public string? ProjectId { get; set; }
    [Parameter] public bool PinProject { get; set; }
    [Parameter] public string? SelectedAgent { get; set; }
    [Parameter] public bool AutoApprove { get; set; }
    [Parameter] public IReadOnlyList<Approval> Approvals { get; set; } = [];
    [Parameter] public EventCallback<string> ConversationOpened { get; set; }
    [Parameter] public EventCallback SpeakerChanged { get; set; }

    private ElementReference dialog, trigger;
    private DotNetObjectReference<ChatVoice>? reference;
    private IJSObjectReference? module;
    private ChatVoiceCall? call;
    private readonly Dictionary<string, CodexVoicePlayback> playbacks = [];
    private VoiceReply? retryReply;
    private long playbackVersion;
    private string? callConversationId, previousConversationId;
    private bool starting, connected, muted, disposed, audioBound;
    private string status = "Connecting…";
    private string? error, speakerName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["chat-voice.js"]);
            if (disposed) { await module.DisposeAsync(); return; }
            await module.InvokeVoidAsync("bindAudio", trigger, dialog);
            audioBound = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private async Task OpenAsync()
    {
        if (module is null || starting || call is not null || disposed) return;
        starting = true;
        connected = muted = false;
        error = null;
        speakerName = null;
        status = "Connecting…";
        try
        {
            reference ??= DotNetObjectReference.Create(this);
            var current = new ChatVoiceCall(Codex, Chats, Worker, Log, ConversationId, ProjectId, SelectedAgent, AutoApprove, PinProject);
            call = current;
            callConversationId = ConversationId;
            current.ConversationOpened += id => _ = InvokeAsync(async () =>
            {
                if (call != current || disposed) return;
                callConversationId = id;
                await ConversationOpened.InvokeAsync(id);
            });
            current.Failed += reason => _ = InvokeAsync(() => ShowErrorAsync(current, reason));
            current.SpeakerChanged += speaker => _ = InvokeAsync(async () =>
            {
                if (call != current || disposed) return;
                speakerName = speaker.Name;
                StateHasChanged();
                await SpeakerChanged.InvokeAsync();
            });
            current.UserSpoke += () => _ = VoicePlaybackAsync(current, null);
            current.ReplyReady += reply => _ = VoicePlaybackAsync(current, reply);
            await module.InvokeVoidAsync("start", dialog, reference, "./" + Assets["voice-capture.js"]);
        }
        catch (JSDisconnectedException) { await ReleaseCallAsync(); }
        catch (JSException)
        {
            error ??= "Could not open the voice call.";
            status = "Connection unavailable";
            await ReleaseCallAsync();
        }
        finally { starting = false; }
    }

    private Task VoicePlaybackAsync(ChatVoiceCall current, VoiceReply? reply) =>
        InvokeAsync(async () =>
        {
            if (call != current || disposed || module is null) return;
            var version = ++playbackVersion;
            if (retryReply is not null) { retryReply = null; StateHasChanged(); }
            try
            {
                if (reply is null)
                {
                    var stopping = ReleasePlaybacksAsync();
                    try { await module.InvokeVoidAsync("interrupt", dialog); }
                    finally { await stopping; }
                    return;
                }
                if (playbacks.Count >= 8) return;
                var id = Guid.NewGuid().ToString("N");
                playbacks.Add(id, new(Codex, reply));
                try
                {
                    var played = await module.InvokeAsync<bool>("speak", CancellationToken.None, [dialog, id, reply.Speaker.Name]);
                    if (!played && call == current && version == playbackVersion && !disposed)
                    {
                        retryReply = reply;
                        StateHasChanged();
                    }
                }
                finally { await CloseVoicePlaybackAsync(id); }
            }
            catch (JSDisconnectedException) { }
            catch (JSException ex) { Log.LogWarning(ex, "ChatGPT voice playback failed."); }
        });

    private Task RetryReplyAsync() => call is { } current && retryReply is { } reply
        ? VoicePlaybackAsync(current, reply) : Task.CompletedTask;

    [JSInvokable]
    public async Task<PlaybackOffer> ConnectVoicePlaybackAsync(string id, string offer)
    {
        if (!playbacks.TryGetValue(id, out var playback)) return new(null, "Voice playback was interrupted.");
        try { return new(await playback.ConnectAsync(offer), null); }
        catch (InvalidOperationException ex) { return new(null, ex.Message); }
        catch (Exception ex) when (ex is ArgumentException or CodexRpcException or TimeoutException or OperationCanceledException or IOException)
        {
            Log.LogDebug(ex, "Could not open a ChatGPT playback connection.");
            return new(null, "Could not connect to the selected ChatGPT voice.");
        }
    }

    public sealed record PlaybackOffer(string? Sdp, string? Error);

    [JSInvokable]
    public async Task<bool> RenderVoicePlaybackAsync(string id)
    {
        if (!playbacks.TryGetValue(id, out var playback)) return false;
        try { return await playback.RenderAsync(); }
        catch (Exception ex) when (ex is CodexRpcException or TimeoutException or OperationCanceledException or IOException)
        {
            Log.LogDebug(ex, "Could not render a ChatGPT voice reply.");
            return false;
        }
    }

    [JSInvokable]
    public async Task<bool> CloseVoicePlaybackAsync(string id)
    {
        if (!playbacks.Remove(id, out var playback)) return false;
        var canPlay = playback.CanPlay;
        await playback.DisposeAsync();
        return canPlay;
    }

    protected override async Task OnParametersSetAsync()
    {
        var changed = ConversationId != previousConversationId;
        previousConversationId = ConversationId;
        if (changed && call is not null && ConversationId != callConversationId)
            await CloseAsync();
    }

    [JSInvokable]
    public async Task<string?> ConnectVoiceAsync(string offer)
    {
        var current = call;
        if (current is null) return null;
        try
        {
            var answer = await current.StartAsync(offer);
            if (call == current)
            {
                speakerName = current.Speaker.Name;
                StateHasChanged();
            }
            return answer;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or CodexRpcException
            or TimeoutException or OperationCanceledException or IOException)
        {
            var message = ex is TimeoutException or OperationCanceledException ? "The voice connection timed out." : ex.Message;
            await ShowErrorAsync(current, message);
            return null;
        }
    }

    [JSInvokable]
    public Task VoiceReadyAsync()
    {
        if (call is not null)
        {
            connected = true;
            status = "Voice call ready";
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task VoiceFailedAsync(string reason) => call is { } current ? ShowErrorAsync(current, reason) : Task.CompletedTask;

    private async Task ShowErrorAsync(ChatVoiceCall current, string reason)
    {
        if (call != current || disposed) return;
        error = reason;
        status = "Connection unavailable";
        if (!disposed) StateHasChanged();
        await EndAsync();
        if (!disposed) StateHasChanged();
    }

    private async Task ToggleMuteAsync()
    {
        if (module is null || !connected) return;
        muted = !muted;
        await module.InvokeVoidAsync("mute", dialog, muted);
        status = muted ? "Microphone muted" : "Voice call ready";
    }

    private async Task CloseAsync()
    {
        try { if (module is not null) await module.InvokeVoidAsync("close", dialog); }
        catch (JSDisconnectedException) { }
        finally { await EndAsync(); }
    }

    private async Task EndAsync()
    {
        connected = false;
        try { if (module is not null) await module.InvokeVoidAsync("stop", dialog); }
        catch (JSDisconnectedException) { }
        finally { await ReleaseCallAsync(); }
    }

    private async Task ReleaseCallAsync()
    {
        var previous = call;
        call = null;
        retryReply = null;
        await ReleasePlaybacksAsync();
        if (previous is not null) await previous.DisposeAsync();
    }

    private Task ReleasePlaybacksAsync()
    {
        var pending = playbacks.Values.ToArray();
        playbacks.Clear();
        return Task.WhenAll(pending.Select(playback => playback.DisposeAsync().AsTask()));
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await EndAsync();
        reference?.Dispose();
        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
