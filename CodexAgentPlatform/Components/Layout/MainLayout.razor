@inherits LayoutComponentBase
@implements IDisposable
@inject ReleaseCatalog Releases

<AuthorizeView>
    <Authorized Context="session">
        <div class="platform">
            <aside class="rail">
                @Brand
                @NavigationLinks
                @Account(session.User.Identity?.Name)
            </aside>
            <header class="mobile-header">
                <button class="icon-button" type="button" aria-controls="mobile-menu" aria-haspopup="dialog" aria-label="Open menu"><Icon Name="menu" /></button>
                @Brand
                <a class="icon-button" href="/conversations" aria-label="Conversations"><Icon Name="history" /></a>
            </header>
            <dialog class="mobile-menu" id="mobile-menu" aria-label="Workspace menu">
                <div class="menu-head">@Brand<button class="icon-button" type="button" data-close-menu autofocus aria-label="Close menu"><Icon Name="close" /></button></div>
                @NavigationLinks
                @Account(session.User.Identity?.Name)
            </dialog>
            <main class="main-pane">@Body</main>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="access-shell">@Body</main>
    </NotAuthorized>
</AuthorizeView>
<div id="blazor-error-ui" data-nosnippet>
    A connection error occurred. <a href="" class="reload">Refresh</a><button class="dismiss" aria-label="Close"><Icon Name="close" /></button>
</div>

@code {
    protected override void OnInitialized() => Releases.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Releases.Changed -= Refresh;

    private RenderFragment Brand => @<a class="brand" href="/"><BrandMark /><span>Codex <small>Agent Platform</small></span></a>;

    private RenderFragment NavigationLinks => @<nav aria-label="Workspace">
        <div class="nav-label">Workspace</div>
        @Link("/", "chat", "Chat")
        @Link("/conversations", "history", "Conversations")
        @Link("/agents", "agents", "Agents")
        @Link("/work", "work", "Work history")
        @Link("/memory", "memory", "Memory")
        @Link("/timeline", "timeline", "Activity timeline")
        <div class="nav-label">Administration</div>
        @Link("/projects", "folder", "Projects")
        @Link("/resources", "grid", "Resources")
        @Link("/approvals", "approve", "Approvals")
        @Link("/codex", "terminal", "Codex settings")
        @Link("/system", "settings", "System settings")
        @if (Releases.Available is { } version)
        {
            @Link("/update", "settings", $"Yeni sürüm var · {version}")
        }
    </nav>;

    private RenderFragment Link(string href, string icon, string label) =>
        @<NavLink class="nav-item" href="@href" Match="NavLinkMatch.All"><Icon Name="@icon" />@label</NavLink>;

    private RenderFragment Account(string? name) => @<div class="account-footer">
        <ThemeSwitch />
        <div class="version-divider">
            <a class="installed-version" href="/update" aria-label="Installed version and updates">
                @(Releases.Current ?? "Version")
            </a>
        </div>
        <div class="rail-footer">
            <span class="avatar avatar-small" aria-hidden="true">@(string.IsNullOrWhiteSpace(name) ? "A" : name[..1].ToUpperInvariant())</span>
            <span class="owner-name">@name</span>
            <form action="/session/logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="icon-button" title="Sign out" aria-label="Sign out"><Icon Name="logout" /></button>
            </form>
        </div>
    </div>;
}
