@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized Context="session">
        <div class="platform">
            <aside class="rail">
                @Brand
                @NavigationLinks
                @Account(session.User.Identity?.Name)
            </aside>
            <header class="mobile-header">
                @Brand
                <a class="icon-button" href="/conversations" aria-label="Sohbet geçmişi"><Icon Name="history" /></a>
                <button class="icon-button" type="button" popovertarget="mobile-menu" aria-label="Menüyü aç"><Icon Name="menu" /></button>
            </header>
            <div class="mobile-menu" id="mobile-menu" popover="auto" role="dialog" aria-label="Çalışma alanı menüsü">
                <div class="menu-head">@Brand<button class="icon-button" type="button" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Menüyü kapat"><Icon Name="close" /></button></div>
                @NavigationLinks
                @Account(session.User.Identity?.Name)
            </div>
            <main class="main-pane">@Body</main>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="access-shell">@Body</main>
    </NotAuthorized>
</AuthorizeView>
<div id="blazor-error-ui" data-nosnippet>
    Bağlantıda bir hata oluştu. <a href="" class="reload">Yenile</a><button class="dismiss" aria-label="Kapat"><Icon Name="close" /></button>
</div>

@code {
    private RenderFragment Brand => @<a class="brand" href="/"><span class="brand-mark"><Icon Name="brand" /></span><span>Codex <small>Agent Platform</small></span></a>;

    private RenderFragment NavigationLinks => @<nav aria-label="Çalışma alanı">
        <div class="nav-label">Çalışma alanı</div>
        @Link("/", "chat", "Sohbet")
        @Link("/conversations", "history", "Sohbet geçmişi")
        @Link("/agents", "agents", "Ajanlar")
        @Link("/work", "work", "Çalışmalar")
        @Link("/memory", "memory", "Hafıza")
        @Link("/timeline", "timeline", "Zaman çizelgesi")
        <div class="nav-label">Yönetim</div>
        @Link("/projects", "folder", "Projeler")
        @Link("/resources", "grid", "Kaynaklar")
        @Link("/approvals", "approve", "Onaylar")
        @Link("/codex", "terminal", "Codex ayarları")
        @Link("/system", "settings", "Sistem")
    </nav>;

    private RenderFragment Link(string href, string icon, string label) =>
        @<NavLink class="nav-item" href="@href" Match="NavLinkMatch.All"><Icon Name="@icon" />@label</NavLink>;

    private RenderFragment Account(string? name) => @<div class="rail-footer">
        <span class="avatar avatar-small" aria-hidden="true">@(string.IsNullOrWhiteSpace(name) ? "Y" : name[..1].ToUpperInvariant())</span>
        <span class="owner-name">@name</span>
        <form action="/session/logout" method="post">
            <AntiforgeryToken />
            <button type="submit" class="icon-button" title="Çıkış yap" aria-label="Çıkış yap"><Icon Name="logout" /></button>
        </form>
    </div>;
}
